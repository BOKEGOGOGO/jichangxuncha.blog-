---
// loading：一条线逐点穿过墙上的缺口，接通后整层淡出。
const COLS = 13, ROWS = 7, WALL = 6, GAP = 3;
const route = [[0, 5], [1, 5], [2, 5], [3, 5], [3, 4], [3, 3], [4, 3], [5, 3], [6, 3], [7, 3], [8, 3], [9, 3], [9, 2], [9, 1], [10, 1], [11, 1], [12, 1]];
const order = new Map(route.map(([x, y], i) => [`${x},${y}`, i]));
const cells = [];
for (let y = 0; y < ROWS; y++) for (let x = 0; x < COLS; x++) {
  const step = order.get(`${x},${y}`);
  cells.push({ x, y, step, wall: x === WALL && y !== GAP });
}
---
<div class="loader" id="loader" role="status" aria-label="机场巡查正在加载">
  <div class="lo-box">
    <svg class="lo-grid" viewBox="0 0 260 140" aria-hidden="true">
      {cells.map((c) => (
        <circle cx={10 + c.x * 20} cy={10 + c.y * 20} r={c.wall ? 4.4 : 2.2}
          class:list={[c.wall ? 'lo-wall' : 'lo-dot', c.step !== undefined && 'lo-step']}
          data-step={c.step}/>
      ))}
    </svg>
    <div class="lo-text"><span>机场巡查</span><output class="mono" id="lo-pct">0%</output></div>
  </div>
</div>
<noscript><style>.loader{display:none!important}</style></noscript>

<script>
  const root = document.documentElement;
  const loader = document.getElementById('loader');

  if (loader && root.classList.contains('loading')) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pct = document.getElementById('lo-pct');
    const steps = [...loader.querySelectorAll('.lo-step')].sort((a, b) => a.dataset.step - b.dataset.step);
    const started = performance.now();
    const minTime = calm ? 300 : 1500;
    const maxTime = 3600;
    let pageReady = false, leaving = false;

    Promise.all([
      document.readyState === 'complete' ? null : new Promise((r) => addEventListener('load', r, { once: true })),
      document.fonts ? document.fonts.ready : null,
    ]).then(() => { pageReady = true; });

    const paint = (p) => {
      pct.textContent = `${Math.round(p * 100)}%`;
      const lit = Math.round(p * steps.length);
      steps.forEach((s, i) => s.classList.toggle('on', i < lit));
    };

    const finish = () => {
      if (leaving) return;
      leaving = true;
      paint(1);
      try { sessionStorage.setItem('jx-boarded', '1'); } catch {}
      const hold = calm ? 0 : 260;
      setTimeout(() => {
        loader.classList.add('leaving');
        root.classList.remove('loading');
        root.classList.add('is-ready');
      }, hold);
      setTimeout(() => loader.remove(), hold + 700);
    };

    const tick = (now) => {
      if (leaving) return;
      const t = now - started;
      // 没加载完就停在 92%，不假装已经好了。
      const eased = 1 - Math.pow(1 - Math.min(t / minTime, 1), 2);
      paint(pageReady ? eased : Math.min(eased, 0.92));
      if ((pageReady && t >= minTime) || t >= maxTime) { finish(); return; }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    loader.addEventListener('click', finish);
    addEventListener('keydown', finish, { once: true });
  }
</script>

<style is:global>
  .loader{position:fixed;inset:0;z-index:100;display:grid;place-items:center;background:var(--paper);cursor:pointer;transition:opacity .6s,visibility 0s .6s;animation:loader-gone 0s linear 6s forwards}
  @keyframes loader-gone{to{visibility:hidden;pointer-events:none}}
  html.no-loader .loader{display:none}
  .loader.leaving{opacity:0;visibility:hidden;pointer-events:none}
  .lo-box{width:min(340px,72vw)}
  .lo-grid{display:block;width:100%;height:auto}
  .lo-dot{fill:var(--dot);transition:fill .12s,r .12s}
  .lo-wall{fill:var(--ink)}
  .lo-step.on{fill:var(--accent);r:4.4px}
  .lo-text{display:flex;justify-content:space-between;align-items:baseline;margin-top:18px;padding-top:12px;border-top:1px solid var(--ink);font:500 15px var(--head)}
  .lo-text output{color:var(--muted)}
</style>
