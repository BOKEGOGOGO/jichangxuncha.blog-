---
// 三张手工几何海报，对应三个登机口。不用照片，放大后依然锐利。
const { kind } = Astro.props;
const leds = Array.from({ length: 8 }, (_, i) => i);
const lights = [[252, 340], [228, 400], [196, 480], [152, 590], [92, 740]];
---
{kind === 'A' && (
  <svg class="art art-a" viewBox="0 0 600 800" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <rect width="600" height="800" fill="#1E45D8"/>
    <circle class="art-sun" cx="300" cy="300" r="128" fill="#FFC700"/>
    <rect y="300" width="600" height="500" fill="#111"/>
    <path d="M276 300h48l236 500H40Z" fill="#E4E2DC"/>
    <g fill="#111"><path d="M297 325h6l1 28h-8ZM295 385h10l2 50h-14ZM292 472h16l4 80h-24ZM286 596h28l7 120h-42Z"/></g>
    <g fill="#111"><path d="M78 760h40l-10 40H62ZM132 760h40l-5 40h-46ZM428 760h40l5 40h-46ZM482 760h40l16 40h-46Z"/></g>
    <g class="art-lights" fill="#FFC700">
      {lights.map(([x, y], i) => <circle cx={x} cy={y} r={2 + i * 1.6} style={`--i:${i}`}/>)}
      {lights.map(([x, y], i) => <circle cx={600 - x} cy={y} r={2 + i * 1.6} style={`--i:${i}`}/>)}
    </g>
  </svg>
)}
{kind === 'V' && (
  <svg class="art art-v" viewBox="0 0 800 500" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <rect width="800" height="500" fill="#D7141A"/>
    <g class="art-waves" fill="none" stroke="#FFC700" stroke-width="7">
      <path d="M604 28a40 40 0 0 1 0 56M520 84a40 40 0 0 1 0-56"/>
      <path d="M628 6a74 74 0 0 1 0 100M496 106a74 74 0 0 1 0-100"/>
    </g>
    <path d="M562 0v60" stroke="#111" stroke-width="7"/>
    <path d="M440 58h244l-34 84H474Z" fill="#111"/>
    <path d="M466 76h40l8 46h-32ZM520 76h34v46h-28ZM570 76h34l-6 46h-28ZM620 76h38l-16 46h-30Z" fill="#E4E2DC"/>
    {leds.map((i) => (
      <g transform={`translate(472 ${152 + i * 44})`}>
        <rect width="180" height="38" fill="#111"/>
        <rect x="52" y="16" width="112" height="6" fill="#3a3a37"/>
        <circle class="art-led" cx="18" cy="19" r="5" fill="#FFC700" style={`--i:${(i * 3) % 8}`}/>
        <circle cx="36" cy="19" r="5" fill="#E4E2DC"/>
      </g>
    ))}
  </svg>
)}
{kind === 'Y' && (
  <svg class="art art-y" viewBox="0 0 800 500" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <rect width="800" height="500" fill="#FFC700"/>
    <g class="art-coin">
      <circle cx="665" cy="345" r="172" fill="#111"/>
      <circle cx="665" cy="345" r="148" fill="none" stroke="#FFC700" stroke-width="4" stroke-dasharray="3 12"/>
      <text x="665" y="325" text-anchor="middle" class="art-coin-t">¥1</text>
    </g>
    <g fill="#FFC700"><rect x="470" y="392" width="330" height="7"/><rect x="470" y="416" width="330" height="11"/><rect x="470" y="444" width="330" height="15"/></g>
    <rect y="470" width="800" height="30" fill="#111"/>
    <g class="art-fly" transform="translate(600 76) rotate(-10) scale(1.3)">
      <path d="M30 0C30-3 24-4 18-4H6L-6-24h-7l7 20h-14l-6-8h-5l3 12-3 12h5l6-8H-6l-7 20h7L6 4h12c6 0 12-1 12-4Z" fill="#1E45D8"/>
    </g>
  </svg>
)}
