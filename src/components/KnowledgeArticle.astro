---
import KnowledgeLayout from '../layouts/KnowledgeLayout.astro';
import {libraryArticles,libraryBySlug,libraryGroups,libraryUpdated} from '../data/knowledge-library';
const {article:a}=Astro.props;const group=libraryGroups.find(g=>g.id===a.group);const related=a.related.map(libraryBySlug).filter(Boolean);
const peers=libraryArticles.filter(x=>x.group===a.group);const index=peers.findIndex(x=>x.slug===a.slug);const prev=peers[index-1],next=peers[index+1];
---
<KnowledgeLayout title={a.title} description={a.description} path={a.path} faqs={a.faqs} updated={a.updated}><article><nav class="vps-breadcrumb" aria-label="面包屑"><a href="/knowledge/">网络知识库</a><span>/</span><a href={'/knowledge/#'+a.group}>{group.title}</a></nav><header class="page-head vps-article-head"><span class="vps-kicker mono">FIELD NOTES / {group.title}</span><h1>{a.title}</h1><p>{a.lead}</p><p class="vps-source">内容与来源核对：<time datetime={a.updated ?? libraryUpdated}>{a.updated ?? libraryUpdated}</time> · 机场巡查博客编辑整理</p></header><div class="vps-editorial"><nav class="vps-toc" aria-label="文章目录">{a.sections.map(s=><a href={'#'+s.id}>{s.title}</a>)}{a.faqs?.length>0&&<a href="#article-faq">常见问题</a>}<a href="#sources">资料与边界</a><a href="#related">继续阅读</a></nav><div class="vps-prose">{a.sections.map(s=><section id={s.id}><h2>{s.title}</h2>{s.paragraphs.map(p=><p>{p}</p>)}{s.table&&<div class="vps-table-scroll" tabindex="0" role="region" aria-label={s.title+'对照表'}><table><caption>{s.title}：判断与核对要点</caption><thead><tr>{s.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{s.table.rows.map(row=><tr>{row.map((c,i)=>i===0?<th scope="row">{c}</th>:<td>{c}</td>)}</tr>)}</tbody></table></div>}{s.code&&<pre><code>{s.code}</code></pre>}{s.steps&&<ol>{s.steps.map(step=><li>{step}</li>)}</ol>}{s.links&&<div class="vps-related">{s.links.map(l=><a href={l.href}>{l.label} →</a>)}</div>}</section>)}{a.faqs?.length>0&&<section id="article-faq"><h2>常见问题</h2><div class="vps-faq">{a.faqs.map(([q,answer])=><details><summary>{q}</summary><p>{answer}</p></details>)}</div></section>}
{a.decision&&<aside class="vps-decision"><h2>{a.decision.title}</h2>{a.decision.paragraphs.map(text=><p>{text}</p>)}<div class="vps-related">{a.decision.links.map(l=><a href={l.href}>{l.label} →</a>)}</div>{a.decision.disclosure&&<p class="vps-source">推荐页含官方合作推广入口，本站可能获得佣金，不会因此额外增加用户付款。合作关系不等于性能或隐私实测；价格、资格与支持以官方当前说明为准。</p>}</aside>}
<section id="sources"><h2>技术资料与验证边界</h2><ul class="vps-sources">{a.sources.map(s=><li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul><p class="vps-source">依据公开项目文档、规范或原始研究整理。操作与排查建议是编辑分析，不是节点实测或服务器封锁鉴定；版本、平台分发和实际服务状态仍需复核。未采集订阅或账号，不提供未知安装包。</p></section><section id="related"><h2>继续阅读</h2><div class="vps-related">{related.map(r=><a href={r.path}>{r.title} →</a>)}{prev&&<a href={prev.path}>同类上一篇：{prev.title} →</a>}{next&&<a href={next.path}>同类下一篇：{next.title} →</a>}<a href={'/knowledge/#'+a.group}>返回{group.title}目录 →</a></div></section></div></div></article></KnowledgeLayout>
