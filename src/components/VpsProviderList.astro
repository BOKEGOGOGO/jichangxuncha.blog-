---
import {vpsProviders,verifiedDate} from '../data/vps';
---
<div class="provider-list">{vpsProviders.map((p,i)=><article class="provider-row"><div class="provider-identity"><span class="mono">{String(i+1).padStart(2,'0')} / 官方资料对照</span><h3>{p.name}</h3><p>{p.subtitle}</p><span class="vps-badge">{p.slug==='digitalocean'?'代表套餐参数已核对':'具体套餐报价待确认'}</span><div class="vps-actions"><a class="vps-link" href={'/vps/providers/'+p.slug+'/'}>完整资料 →</a><a class="vps-link" href={p.purchase} target="_blank" rel="noopener noreferrer">官方产品页 ↗</a></div></div><div class="provider-specs"><dl><div><dt>{p.slug==='digitalocean'?'代表套餐标价':'价格状态'}</dt><dd>{p.price}<small>{p.priceDetail}</small></dd></div><div><dt>机房地区</dt><dd>{p.regions}</dd></div><div><dt>CPU / RAM / 硬盘</dt><dd>{p.cpu} / {p.ram} / {p.disk}</dd></div><div><dt>流量与带宽</dt><dd>{p.transfer}；{p.bandwidth}</dd></div><div><dt>适合与限制</dt><dd>{p.fit}。{p.caution}。</dd></div></dl><p class="vps-source">核对日期：<time datetime={verifiedDate}>{verifiedDate}</time> · 仅官方资料，无本站跑分或线路验证。</p></div></article>)}</div>
