---
import Layout from '../layouts/Layout.astro';
import {siteInfoPages,siteInfoUpdated} from '../data/site-info';
const {page}=Astro.props;const path='/'+page.slug+'/';const url='https://jichangxuncha.blog'+path;
const graph={'@context':'https://schema.org','@graph':[{'@type':page.slug==='about'?'AboutPage':'WebPage',name:page.title,description:page.description,url,inLanguage:'zh-CN',dateModified:siteInfoUpdated},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:'https://jichangxuncha.blog/'},{'@type':'ListItem',position:2,name:page.label,item:url}]}]};
---
<Layout title={page.title} description={page.description} canonicalPath={path} seo><Fragment slot="seo"><meta property="og:type" content="website"/><meta property="og:title" content={page.title}/><meta property="og:description" content={page.description}/><meta property="og:url" content={url}/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/></Fragment><article class="wrap info-page"><nav class="info-crumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span aria-current="page">{page.label}</span></nav><header class="page-head"><p class="mono">JICHANGXUNCHA / SITE INFORMATION</p><h1>{page.title}</h1><p class="info-intro">{page.intro}</p><p class="mono info-date">更新：<time datetime={siteInfoUpdated}>{siteInfoUpdated}</time></p></header><div class="sec"><aside class="sec-head"><nav class="sec-sticky info-nav" aria-label="本站说明页面">{siteInfoPages.map(p=><a href={'/'+p.slug+'/'} aria-current={p.slug===page.slug?'page':undefined}>{p.label} →</a>)}<a href="/knowledge/">进入网络知识库 →</a></nav></aside><div class="sec-body info-copy">{page.sections.map(([heading,paragraphs],i)=><section id={'section-'+(i+1)}><h2>{heading}</h2>{paragraphs.map(text=><p>{text}</p>)}</section>)}<section><h2>继续阅读</h2><p><a href="/knowledge/">网络知识库</a> · <a href="/category/airports/">机场推荐与品牌资料</a> · <a href="/category/vps/">VPS知识中心</a> · <a href="/category/clash/">Clash指南</a></p><p><a href="/knowledge/subscription-leak/">订阅凭证泄露处理</a> · <a href="/knowledge/support-report/">脱敏报障模板</a></p></section></div></div></article></Layout>
<style>.info-crumbs{display:flex;gap:14px;font-size:12px;color:var(--muted);padding-top:30px}.info-page .page-head{max-width:1050px}.info-page h1{font-size:clamp(32px,4vw,54px);line-height:1.4}.info-intro{font-size:17px;line-height:1.9;color:var(--muted);margin-top:24px;max-width:48em}.info-date{color:var(--muted);margin-top:20px;font-size:11px}.info-nav{display:flex;flex-direction:column;gap:16px;font-size:14px}.info-nav a[aria-current=page]{color:var(--accent)}.info-copy{max-width:52em}.info-copy section{padding:0 0 30px;margin-bottom:30px;border-bottom:1px solid var(--line);scroll-margin-top:100px}.info-copy h2{font-size:clamp(23px,2.3vw,30px);line-height:1.5;margin-bottom:20px}.info-copy p{font-size:16px;line-height:2;margin:14px 0}.info-copy a{text-decoration:underline;text-underline-offset:4px;color:var(--accent)}@media(max-width:760px){.info-page .sec{display:block}.info-nav{position:static;margin-bottom:36px;gap:12px}.info-copy p,.info-intro{font-size:15px}}</style>
