---
import BrandActions from './BrandActions.astro';
const { brand: b } = Astro.props;
---
<div class="dossier"><p class="source">资料来源：品牌官方提供资料。本站整理于2026-11-09，未独立完成测速、付款或当前结算验证。</p><p>{b.tagline}</p><section><h2>套餐价格与优惠计算</h2><p>原价为资料列示付款周期的总价；流量按月、30天或总量分别标明。折后金额仅依据所列优惠计算，实际资格、周期与实付请在结算前确认。</p><div class="table-scroll"><table><caption>{b.name}已提供套餐价格</caption><thead><tr><th>套餐</th><th>流量</th><th>付款周期</th><th>原价</th><th>优惠计算价</th></tr></thead><tbody>{b.prices.map(p=><tr><td>{p.name}</td><td>{p.traffic}</td><td>{p.period}</td><td>¥{p.price}</td><td>{p.eligible ? '¥'+(p.price*b.coupon.rate).toFixed(2) : b.coupon.active === false ? '无当前优惠' : '不适用'}</td></tr>)}</tbody></table></div></section><section><h2>{b.coupon.active === false ? '优惠活动状态' : b.coupon.code+'优惠码与限制'}</h2><p>{b.coupon.description}</p></section>{b.resetPackages?.length>0 && <section><h2>资料列示重置流量价格</h2><div class="table-scroll"><table><thead><tr><th>对应套餐</th><th>重置原价</th></tr></thead><tbody>{b.resetPackages.map(p=><tr><td>{p.plan}</td><td>¥{p.price}</td></tr>)}</tbody></table></div><p>重置与重新购买套餐用途不同，不据此承诺延长有效期；是否参与优惠按品牌说明，本表不计算重置优惠。</p></section>}{b.sections.map(([title,...paragraphs])=><section><h2>{title}</h2>{paragraphs.map(p=><p>{p}</p>)}</section>)}<section><h2>{b.name}常见问题</h2>{b.faqs.map(([q,a])=><div><h3>{q}</h3><p>{a}</p></div>)}</section><BrandActions slug={b.slug}/></div>
<style>
.dossier{min-width:0}.source{font-size:13px!important;color:var(--muted)}.toc{display:flex;flex-wrap:wrap;gap:12px 24px;margin:24px 0}.toc a{min-height:40px;display:flex;align-items:center;border-bottom:1px solid var(--line)}section{margin:36px 0;padding-top:24px;border-top:1px solid var(--line);scroll-margin-top:90px}h2{font-size:26px;margin-bottom:16px}h3{font-size:20px;margin:24px 0 12px}p{margin-bottom:18px;line-height:1.95}.table-scroll{max-width:100%;overflow-x:auto;margin:24px 0}table{border-collapse:collapse;width:100%;min-width:540px;font-size:14px}th,td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--line)}th{font-weight:500;color:var(--muted)}caption{text-align:left;margin-bottom:12px;font-size:13px;color:var(--muted)}code{font-family:var(--mono-f);color:var(--accent)}.purchase{padding:24px;background:#0b7a5509;margin-top:32px}.purchase>a{display:inline-flex;align-items:center;min-height:48px;padding:10px 18px;background:var(--accent);color:white}.purchase p{margin:16px 0}@media(max-width:700px){h2{font-size:23px}}
.official{background:transparent!important;color:var(--accent)!important;padding:0!important}</style>