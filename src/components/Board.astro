---
import Flap from './Flap.astro';
import { posts } from '../data/posts';
import { gateOf, flightNo } from '../data/site';
const { rows = posts, filler = true } = Astro.props;
---
<ol class="board">
  <li class="b-head" aria-hidden="true"><span>航班</span><span>目的地</span><span>登机口</span><span>日期</span><span>状态</span><span></span></li>
  {rows.map((post) => {
    const code = flightNo(posts.indexOf(post));
    const gate = gateOf(post.category);
    return (
      <li>
        <a class="b-row" href={`/posts/${post.slug}/`}>
          <span class="b-code" data-board-flap aria-label={`航班 ${code}`}>{[...code].map((c) => <Flap c={c} />)}</span>
          <span class="b-title"><strong>{post.title}</strong><small>{post.description}</small></span>
          <span class="b-gate"><b class={`tone-${gate.tone}`}>{gate.key}</b><em>{post.category}</em></span>
          <span class="b-date">{post.date}<small>{post.time}</small></span>
          <span class="b-status"><i></i>示例</span>
          <span class="b-go" aria-hidden="true">→</span>
        </a>
      </li>
    );
  })}
  {filler && (
    <li class="b-row b-row--idle">
      <span class="b-code b-code--idle">JX···</span>
      <span class="b-title"><strong>下一篇笔记准备中</strong></span>
      <span class="b-gate"></span>
      <span class="b-date">待定</span>
      <span class="b-status b-status--idle">排期中</span>
      <span class="b-go"></span>
    </li>
  )}
</ol>
