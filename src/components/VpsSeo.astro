---
import {verifiedDate} from '../data/vps';
const {title,description,path,kind='WebPage',crumbs=[],faqs=[],updated=verifiedDate}=Astro.props;
const origin='https://jichangxuncha.blog';const url=new URL(path,origin).href;
const fullTitle=title+' · 机场巡查';
const graph={'@context':'https://schema.org','@graph':[
{'@type':'WebSite','@id':origin+'/#website',url:origin+'/',name:'机场巡查博客',inLanguage:'zh-CN'},
{'@type':kind,'@id':url+'#page',url,name:title,description,inLanguage:'zh-CN',dateModified:updated,isPartOf:{'@id':origin+'/#website'},breadcrumb:{'@id':url+'#breadcrumb'},...(['Article','TechArticle'].includes(kind)?{headline:title,author:{'@type':'Organization',name:'机场巡查博客',url:origin+'/'}}:{})},
{'@type':'BreadcrumbList','@id':url+'#breadcrumb',itemListElement:[{name:'首页',href:'/'},...crumbs].map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.href,origin).href}))},
...(faqs.length?[{'@type':'FAQPage','@id':url+'#faq',isPartOf:{'@id':url+'#page'},mainEntity:faqs.map(([name,text])=>({'@type':'Question',name,acceptedAnswer:{'@type':'Answer',text}}))}]:[])
]};
---
<meta name="robots" content="index,follow"/><meta property="og:type" content={['Article','TechArticle'].includes(kind)?'article':'website'}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="机场巡查博客"/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={url}/><meta name="twitter:card" content="summary"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/>
