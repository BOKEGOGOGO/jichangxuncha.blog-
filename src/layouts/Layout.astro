---
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Loader from '../components/Loader.astro';
import Mark from '../components/Mark.astro';

const { title = '机场巡查博客', description = '机场推荐、VPS 与订阅使用笔记。', seo = false, canonicalPath } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { label: '机场推荐', href: '/category/airports/' },
  { label: 'VPS知识', href: '/catagory/vps/' },
  { label: 'Clash', href: '/category/clash/' },
  { label: '节点全超时？', href: '/tools/#diagnose' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#F6F6F3"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2"/>
    <link rel="icon" sizes="32x32" type="image/png" href="/favicon-32.png?v=2"/>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
    <link rel="canonical" href={new URL(canonicalPath ?? path, Astro.site)}/>
    <title>{title} · jichangxuncha.blog</title>
    {seo && <slot name="seo"/>}
    <script is:inline>
      // 一次会话只看一次 loading；地址加 ?loader 可以强制重看。
      (function () {
        var d = document.documentElement, seen = false;
        d.classList.add('js');
        try { seen = !!sessionStorage.getItem('jx-boarded'); } catch (e) { seen = true; }
        if (location.search.indexOf('loader') > -1) seen = false;
        d.classList.add(seen ? 'no-loader' : 'loading');
        if (seen) d.classList.add('is-ready');
        // 兜底：脚本出错也不能把人挡在门外
        setTimeout(function () { d.classList.remove('loading'); d.classList.add('is-ready'); }, 6000);
      })();
    </script>
  </head>
  <body>
    <Loader/>
    <a class="skip" href="#main">跳到正文</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="机场巡查首页"><Mark/><span>机场巡查</span></a>
        <nav aria-label="主导航">
          {nav.map((n) => <a href={n.href} class:list={{'nav-troubleshoot':n.href.startsWith('/tools/')}} title={n.href.startsWith('/tools/')?'套餐已购买，节点却全部超时或报错？先排查网络与连接问题':undefined} aria-current={(path.startsWith(n.href.split('#')[0]) || n.href === '/catagory/vps/' && (path.startsWith('/vps/') || path === '/category/vps/')) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main"><slot/></main>
    <footer class="foot">
      <div class="wrap foot-in">
        <div class="foot-brand"><Mark size={36}/><p>保持观察，认真记录。</p></div>
        <div class="foot-col">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </div>
        <div class="foot-col">
          <a href="/about/">关于本站</a>
          <span class="mono">© {new Date().getFullYear()} jichangxuncha.blog</span>
        </div>
      </div>
    </footer>
    <script>import '../scripts/site.js';</script>
  </body>
</html>
