import Layout from '../../layouts/Layout.astro';
import '../../styles/clash-guide.css';
const title='Clash使用指南：客户端下载、订阅配置、代理模式与常见问题';
const description='Clash是什么、怎么下载和导入订阅？梳理Clash Verge Rev、Clash Meta与Mihomo的关系，分设备说明安装配置、规则与TUN模式、节点超时排查，以及订阅链接和账号安全注意事项。';
const url='https://jichangxuncha.blog/category/clash/';
const contents=[['basics','Clash是什么'],['ecosystem','内核与客户端'],['devices','设备与下载渠道'],['install','分设备安装教程'],['subscription','认识订阅链接'],['import','导入与更新配置'],['modes','代理模式怎么选'],['troubleshooting','无法连接与超时'],['services','Clash与机场'],['faq','常见问题'],['subscription-security','订阅与账号安全']];
const problems=[
['全部节点超时','先查套餐有效期、流量、服务公告和设备时间，再更新配置并抽查两个不同地区的节点。','同一设备与配置切换Wi-Fi和手机热点；记录测试时间。若均失败，带脱敏日志联系服务方，继续区分节点服务、客户端与网络路径。'],
['DIRECT正常，代理节点异常','DIRECT走直连路径，节点测试需经过代理服务器，二者不是同一个检测对象。','核对所选节点、协议和凭证，观察连接日志。直连有响应只能作为本地网络对照，不能证明代理服务器正常。'],
['订阅更新成功，节点仍无法连接','配置下载地址与实际节点的地址、端口可能不同；配置接口正常不代表节点在线。','核对是否激活刚更新的配置、账号是否到期、节点是否维护，再查看节点连接错误。不要反复导入同一链接代替诊断。'],
['订阅导入失败','区分HTTP错误、证书错误和配置解析错误：401/403可能涉及凭证或权限，404可能是地址变化；具体解释以服务方为准。','确认复制完整且格式正确，检查设备时间与客户端版本。若返回登录网页而非配置，向官方索取正确入口；不要默认关闭证书校验。'],
['节点显示延迟，网页却打不开','延迟探测只验证所设测试地址的那次请求，不能代表所有网站、账号、协议或大流量传输。','查看目标域名的连接记录，检查实际命中规则、策略组和DNS错误。尝试另一正常网站，区分单站故障与整体连接异常。'],
['电脑能用，手机不能用','比较两端实际配置、内核支持、网络和设备限制。相同订阅不保证两端版本拥有相同功能。','先在同一Wi-Fi下对照，检查手机连接授权、后台限制及是否同时启用了其他网络接管软件，再核对服务方设备规则。'],
['Wi-Fi失败，手机流量正常','优先核对Wi-Fi是否完成认证，以及DNS、出口路径和管理员策略；保留同设备、同配置、相近时间这一对照条件。','公共或单位网络存在明确访问规则时先咨询管理员。一次对照不能直接证明某省、某运营商全面限制，也不能定位具体过滤机制。'],
['DNS解析异常','在日志中区分域名解析失败与连接IP超时。另查系统时间、网络认证和配置指定的解析服务是否可达。','先恢复服务方提供的可用配置，只改一个设置再对照；不要把来历不明的DNS列表整段覆盖进去。域名能解析也不代表端口可连接。'],
['内核与配置格式不兼容','unknown field、unsupported proxy type等报错通常需要核对字段、协议及其最低支持版本，而不是只看文件后缀。','保留原文件，按项目发布说明升级到受支持的稳定版本，或请服务方提供兼容配置；不要盲删字段让解析勉强通过。'],
['服务商服务器故障','部分地区或同一组节点同时失败，可能涉及服务器、入口、证书、账号系统或维护，不只一种原因。','查看官方公告，用其他正常节点对照，并提交故障时间、节点名称和脱敏错误；不要把订阅凭证公开到评论区。'],
['运营商线路或时段问题','跨网路由、拥塞、丢包、协议适配和出口策略都可能影响体验；单个延迟数字不能给出结论。','在相近时间重复同条件对照，记录网络类型和错误变化。必要时由服务方进一步检查路径；换服务也不保证解决本地网络问题。']
];
const faqs=[
['Clash软件免费，为什么还要购买套餐？','工具软件与连接资源分别提供。项目是否收费取决于其许可和发行方式；节点服务则涉及服务器与带宽。你也可以使用自己管理或获得授权的服务器，并非必须购买机场。'],
['旧版Clash配置能直接给Mihomo使用吗？','不能只按名称判断。常见基础字段可能相近，但协议、规则提供器、脚本与DNS等扩展存在差异。先保留备份，查看解析日志，再按所用内核文档核对，不要覆盖唯一可用配置。'],
['下载页面有很多安装包，怎么选择？','先确认系统，再确认CPU架构。Windows常见x64或ARM64，Mac区分Intel与Apple芯片，Linux还要匹配发行版包格式。不是文件越大越适合；系统要求以项目当前安装说明为准。'],
['订阅能在浏览器打开，客户端为什么导入失败？','浏览器可能已经登录网站，客户端请求则未带相同会话；还可能返回HTML、需要特定格式，或存在证书和网络差异。请官方确认真正的配置URL，分享错误时隐藏令牌。'],
['更新订阅会覆盖自己修改的规则吗？','远程配置更新可能替换下载内容。需要长期保留的修改，应优先使用所用客户端明确支持的覆写或合并机制，并在升级、更新后检查实际生效配置；不同项目处理方式不同。'],
['退出软件以后网页打不开，该查哪里？','先看系统代理是否仍指向已经停止监听的本地端口，以及其他网络接管软件是否仍运行。正常退出并核对系统代理设置；不要通过长期关闭防火墙来解决。'],
['延迟越低，下载速度就越快吗？','不一定。响应延迟、可用带宽、丢包、并发负载和目标网站限速是不同因素。应在自己的常用时段与应用中验证，也不要把一次探测值当成持续速度承诺。'],
['手机省电后频繁断开怎么办？','先确认系统是否暂停客户端、切换了网络，或收回后台运行条件，再按该项目的系统设置说明调整。保留时间和日志，区分应用被停止与远端连接失败，避免无差别放开所有应用权限。'],
['订阅地址不小心发出去了，还能补救吗？','尽快在服务方后台重置订阅令牌或联系官方撤销旧凭证，并核查用量和设备情况。仅删除聊天记录不能保证对方没有保存；修改登录密码也未必会同步作废旧订阅。'],
['Clash需要安装HTTPS根证书吗？','基本的流量转发通常不需要解密HTTPS内容。若某教程额外要求安装根证书，应核实具体功能与信任范围；不要为了解决普通节点超时安装未知证书。'],
['启用TUN后还需要选Rule或Global吗？','需要理解两个设置分工：TUN负责接入流量，Rule、Global、Direct决定进入内核后的转发策略。启用TUN不会自动选好节点，也不会让失效凭证或故障服务器恢复。'],
['客服排查时应该提供哪些资料？','提供客户端与内核版本、操作系统、网络类型、故障时间、受影响范围和脱敏错误。遮住订阅URL中的令牌、密码、密钥及个人信息；不要把整份含凭证配置公开上传。']
];
const schema={'@context':'https://schema.org','@graph':[{'@type':'TechArticle','@id':url+'#article',headline:title,description,inLanguage:'zh-CN',url,dateModified:'2026-11-10',author:{'@type':'Organization',name:'机场巡查博客',url:'https://jichangxuncha.blog/'},mainEntityOfPage:url},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'首页',item:'https://jichangxuncha.blog/'},{'@type':'ListItem',position:2,name:'Clash使用指南',item:url}]},{'@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]};
