---
import Layout from '../../layouts/Layout.astro';
import Board from '../../components/Board.astro';
import PosterArt from '../../components/PosterArt.astro';
import { posts } from '../../data/posts';
import { gates } from '../../data/site';
export function getStaticPaths() { return gates.map((gate) => ({ params: { slug: gate.slug }, props: { gate } })); }
const { gate } = Astro.props;
const rows = posts.filter((p) => p.category === gate.category);
const others = gates.filter((g) => g !== gate);
---
<Layout title={gate.category}>
  <header class={`band band-${gate.tone}`}>
    <div class="band-art"><PosterArt kind={gate.key}/></div>
    <div class="band-text">
      <span class="mono">GATE {gate.key} · FIELD NOTES / 分类笔记</span>
      <h1><span>{gate.category}</span></h1>
      <p class="sub"><span>按主题整理的选购思路、体验记录与使用笔记。</span></p>
    </div>
  </header>
  <section class="wrap"><Board rows={rows}/></section>
  <nav class="more" aria-label="其他栏目">
    {others.map((g) => (
      <a href={`/category/${g.slug}/`}>
        <b class={`tone-${g.tone}`}>{g.key}</b>
        <span>{g.category}<small>{g.desc}</small></span>
        <i aria-hidden="true">→</i>
      </a>
    ))}
  </nav>
</Layout>
<style>
  .sub{margin-top:12px;font-weight:600;font-size:17px}
  .sub span{background:var(--band);box-decoration-break:clone;-webkit-box-decoration-break:clone;padding:2px 7px;margin-left:-7px}
  .wrap{background:var(--ink)}
  .more{display:grid;grid-template-columns:1fr 1fr;background:var(--concrete)}
  .more a{display:flex;align-items:center;gap:18px;padding:clamp(22px,3vw,40px) var(--gutter);transition:background .15s}
  .more a+a{border-left:2px solid var(--ink)}
  .more a:hover{background:var(--paper)}
  .more b{display:grid;place-items:center;flex:none;width:clamp(52px,6vw,80px);aspect-ratio:1;font:800 clamp(34px,4vw,54px)/1 var(--display)}
  .more span{font:900 clamp(24px,3vw,44px)/1.15 var(--display)}
  .more small{display:block;margin-top:5px;font:500 14px var(--body);color:var(--ash)}
  .more i{margin-left:auto;font:800 32px/1 var(--display);font-style:normal}
  @media(max-width:640px){.more{grid-template-columns:1fr}.more a+a{border-left:0;border-top:2px solid var(--ink)}}
</style>
