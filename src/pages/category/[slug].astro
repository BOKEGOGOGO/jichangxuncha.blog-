---
import VpsHome from '../../components/VpsHome.astro';
import Layout from '../../layouts/Layout.astro';
import AirportGuide from '../../components/AirportGuide.astro';
import AirportSeo from '../../components/AirportSeo.astro';
import Glyph from '../../components/Glyph.astro';
import PostList from '../../components/PostList.astro';
import { posts } from '../../data/posts';
import { topics } from '../../data/site';
export function getStaticPaths() { return topics.filter(topic=>topic.slug!=='vps').map((topic) => ({ params: { slug: topic.slug }, props: { topic } })); }
const { topic } = Astro.props;
const rows = posts.filter((p) => p.category === topic.category);
const others = topics.filter((t) => t !== topic);
---
{topic.slug === 'vps' ? <VpsHome/> : <Layout title={topic.slug === 'airports' ? '机场推荐｜按流量、线路与预算找到适合你的套餐' : topic.category} description={topic.slug === 'airports' ? `整理机场推荐与${posts.filter(p=>p.category==='机场推荐').length}家品牌资料，比较月付、年付和不限时套餐，解释IPLC与IEPL线路、设备限制及官方客户端，附购买检查清单和常见问题。` : undefined} seo={topic.slug === 'airports'}>
  {topic.slug === 'airports' && <AirportSeo slot="seo"/>}
  <div class="wrap">
    {topic.slug === 'airports' ? <AirportGuide/> : <><header class="page-head cat-head">
      <div>
        <span class="mono">{topic.no} / FIELD NOTES</span>
        <h1>{topic.category}</h1>
        <p>{topic.slug === 'airports' ? '整理品牌公开信息与套餐细节，帮助你了解不同服务的使用方式。' : '按主题整理的选购思路、体验记录与使用笔记。'}</p>
      </div>
      <div class="cat-art"><Glyph slug={topic.slug}/></div>
    </header>
    <PostList rows={rows} showCategory={false}/></>}
    <nav class="others" aria-label="其他栏目">
      {others.map((t) => (
        <a href={t.slug==='vps'?'/category/vps/':`/category/${t.slug}/`}>
          <span class="mono">{t.no}</span>
          <strong>{t.category}</strong>
          <small>{t.desc}</small>
        </a>
      ))}
    </nav>
  </div>
</Layout>}
<style>
  .cat-head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px}
  .cat-art{flex:none;width:clamp(96px,16vw,220px)}
  .others{display:grid;grid-template-columns:1fr 1fr;margin-top:clamp(48px,6vw,88px);border-top:1px solid var(--line)}
  .others a{padding:clamp(20px,2.4vw,32px) 24px clamp(36px,4vw,56px) 0}
  .others a+a{border-left:1px solid var(--line);padding-left:24px}
  .others .mono{display:block;color:var(--muted);margin-bottom:12px}
  .others strong{display:block;font:500 clamp(20px,2.2vw,28px)/1.3 var(--head);transition:color .15s}
  .others small{font-size:14px;color:var(--muted)}
  .others a:hover strong{color:var(--accent)}
</style>
