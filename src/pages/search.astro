---
import Layout from '../layouts/Layout.astro';
const hints = ['节点超时', 'Clash', '订阅', 'IPLC', 'VPS 线路', '退款', 'Shadowrocket', 'SSH'];
---
<Layout title="站内搜索" description="搜索机场巡查博客的品牌资料、VPS 知识、客户端教程与故障排查文章。" noindex>
  <div class="wrap">
    <header class="page-head">
      <span class="mono">SEARCH</span>
      <h1>站内搜索</h1>
    </header>
    <form class="sbox" action="/search/" method="get" role="search">
      <label for="q" class="mono">搜索品牌、客户端、错误或术语</label>
      <div class="sbox-row">
        <input id="q" name="q" type="search" autocomplete="off" placeholder="例如：节点全部超时" enterkeyhint="search"/>
        <button type="submit">搜索</button>
      </div>
    </form>
    <p class="hints"><span class="mono">常见搜索</span>{hints.map((h) => <a href={`/search/?q=${encodeURIComponent(h)}`} data-q={h}>{h}</a>)}</p>
    <p id="s-status" class="s-status" role="status" aria-live="polite"></p>
    <ol id="s-results" class="results"></ol>
    <noscript><p class="s-status">搜索需要启用 JavaScript。也可以从 <a href="/knowledge/">网络知识库</a> 或 <a href="/category/airports/">机场推荐</a> 按栏目浏览。</p></noscript>
  </div>
</Layout>

<script>
  type Row = { u: string; t: string; d: string; k: string; h: string };
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('s-results')!;
  const status = document.getElementById('s-status')!;
  let rows: Row[] | null = null;

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // 所有关键词合成一条正则，在原文上一次切分后再分别转义。
  // 逐词替换会让后面的词匹配到前面插入的 <mark> 标签（例如搜“Clash a”会把标签拆坏）。
  const mark = (text: string, terms: string[]) => {
    const words = [...new Set(terms)].sort((a, b) => b.length - a.length);
    if (!words.length) return esc(text);
    const re = new RegExp(`(${words.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
    return text.split(re).map((part, i) => (i % 2 ? `<mark>${esc(part)}</mark>` : esc(part))).join('');
  };

  const load = async () => {
    if (rows) return rows;
    const res = await fetch('/search-index.json');
    rows = (await res.json()) as Row[];
    return rows;
  };

  const run = async (raw: string) => {
    const q = raw.trim();
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    list.innerHTML = '';
    if (!q) { status.textContent = ''; return; }
    let data: Row[];
    try { data = await load(); } catch { status.textContent = '搜索索引加载失败，请刷新后再试。'; return; }
    // 中文不按空格分词：整句先匹配，再按空格拆成多个词，全部命中才算结果
    const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
    const scored = data.map((r) => {
      const t = r.t.toLowerCase(), d = r.d.toLowerCase(), h = r.h.toLowerCase(), k = r.k.toLowerCase();
      let score = 0;
      for (const term of terms) {
        const s = (t.includes(term) ? 6 : 0) + (h.includes(term) ? 2 : 0) + (d.includes(term) ? 2 : 0) + (k.includes(term) ? 1 : 0);
        if (!s) return null;
        score += s;
      }
      return { r, score };
    }).filter(Boolean) as { r: Row; score: number }[];
    scored.sort((a, b) => b.score - a.score);
    status.textContent = scored.length ? `找到 ${scored.length} 个相关页面` : `没有找到与“${q}”相关的页面。换个说法试试，或者从网络知识库按栏目浏览。`;
    list.innerHTML = scored.slice(0, 40).map(({ r }) => `
      <li><a href="${r.u}">
        <span class="mono">${esc(r.k)}</span>
        <strong>${mark(r.t, terms)}</strong>
        <small>${mark(r.d, terms)}</small>
      </a></li>`).join('');
  };

  let timer = 0;
  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => run(input.value), 160); });
  document.querySelector('.sbox')!.addEventListener('submit', (e) => { e.preventDefault(); run(input.value); });
  document.querySelectorAll<HTMLAnchorElement>('[data-q]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); input.value = a.dataset.q!; run(input.value); input.focus();
  }));
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; run(initial); } else { input.focus(); }
</script>

<style>
  .sbox{max-width:760px}
  .sbox label{display:block;color:var(--muted);margin-bottom:10px}
  .sbox-row{display:flex;border:1px solid var(--ink);background:#fff}
  .sbox input{flex:1;min-width:0;min-height:56px;padding:0 16px;border:0;background:transparent;font:500 17px var(--head);color:var(--ink)}
  .sbox input:focus{outline:none}
  .sbox-row:focus-within{outline:2px solid var(--accent);outline-offset:2px}
  .sbox button{flex:none;min-width:88px;border:0;background:var(--ink);color:var(--paper);font:500 15px var(--head);cursor:pointer;transition:background .15s}
  .sbox button:hover{background:var(--accent)}
  .hints{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;margin-top:20px;font-size:14px}
  .hints .mono{color:var(--muted);margin-right:4px}
  .hints a{display:inline-flex;align-items:center;min-height:36px;border-bottom:1px solid var(--line);transition:color .15s,border-color .15s}
  .hints a:hover{color:var(--accent);border-color:var(--accent)}
  .s-status{margin-top:40px;font-size:14px;color:var(--muted)}
  .results{margin-top:12px;margin-bottom:clamp(56px,8vw,112px);border-top:1px solid var(--ink);max-width:960px}
  .results:empty{border-top:0}
  .results :global(li){border-bottom:1px solid var(--line)}
  .results :global(a){display:block;padding:20px 0}
  .results :global(.mono){display:block;color:var(--muted)}
  .results :global(strong){display:block;margin-top:4px;font:500 clamp(18px,1.8vw,22px)/1.4 var(--head);transition:color .15s}
  .results :global(small){display:block;margin-top:4px;font-size:15px;color:var(--muted)}
  .results :global(a:hover strong){color:var(--accent)}
  .results :global(mark){background:#0b7a5524;color:inherit;padding:0 1px}
</style>
