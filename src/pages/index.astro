---
import Layout from '../layouts/Layout.astro';
import DotField from '../components/DotField.astro';
import Glyph from '../components/Glyph.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../data/posts';
import { topics } from '../data/site';
import { knowledgeArticles } from '../data/vps-knowledge';

// 首页清单是通用选购要点，摘自机场推荐页“购买前检查七件事”，不跟随某一家品牌。
const checks = [
  ['看流量', '是每月重置还是一次性总量？余额结转、倍率与重置费是否写清楚。'],
  ['看兼容', '设备能否安装指定客户端。部分品牌只提供官方客户端，私人订阅链接通常需要高付费套餐并持有邀请码才能申请。'],
  ['看条款', '退款、续费、套餐变更和优惠限制是否明确；长周期折扣先确认需求变化时能否退出。'],
];
// VPS 栏目的主体是知识中心专题，不是 posts 里的单篇笔记。
const count = (t) => (t.slug === 'vps' ? knowledgeArticles.length : posts.filter((p) => p.category === t.category).length);
const brandCount = posts.filter((p) => p.category === '机场推荐').length;

// 按“选之前 → 连上 → 出问题”三个阶段排的常见问题入口；锚文本就是读者会搜的问题。
const stages = [
  { code: 'BEFORE', title: '选之前', items: [
    ['第一次接触：节点、订阅、客户端是什么？', '/knowledge/proxy-basics/'],
    ['专线机场怎么挑？先看品牌资料与选购清单', '/category/airports/'],
    ['月付、年付还是不限时流量？', '/knowledge/plan-costs/'],
    ['每月大概需要多少流量？', '/tools/traffic/'],
  ] },
  { code: 'SETUP', title: '连上', items: [
    ['机场客户端怎么用：官方客户端六步连上', '/knowledge/client-comparison/'],
    ['为什么普通套餐不给订阅链接？', '/knowledge/client-comparison/#official'],
    ['Clash 使用指南', '/category/clash/'],
    ['小火箭 Shadowrocket 导入与规则', '/knowledge/shadowrocket/'],
  ] },
  { code: 'TROUBLE', title: '出问题', items: [
    ['节点全部超时怎么办？', '/knowledge/node-timeout/'],
    ['有延迟却打不开网页', '/knowledge/latency-without-access/'],
    ['晚高峰特别卡', '/knowledge/peak-hour-slowdown/'],
    ['为什么机场越用越卡？', '/knowledge/subscription-sharing/'],
  ] },
];

// 首页常见问题：页面可见内容与 FAQPage 结构化数据共用同一份文字。
const faqs = [
  ['机场巡查博客是做什么的？', `整理专线机场的套餐资料、客户端使用教程和节点故障排查方法。目前收录 ${brandCount} 家品牌资料，另有网络知识库和 VPS 知识中心，帮助你在购买前对照、在连不上时自己排查。`],
  ['本站有没有测速排名？', '没有。不同地区、运营商和时段的网络表现差别很大，单一环境的测速不能代表你的体验，所以本站只整理品牌公开资料，并提供工具让你检测自己的网络。'],
  ['推荐的机场能用 Clash 或小火箭吗？', '本站收录的机场以官方客户端为主，普通套餐不提供可导入第三方软件的订阅链接；私人订阅链接需要购买高付费套餐并持有邀请码，再向官方客服申请。'],
  ['通过本站链接购买会多花钱吗？', '不会。部分品牌入口是合作推广链接，本站可能从中获得一小笔佣金，用来维持网站运行，不会增加你的付款金额。'],
];

// 首页定位：站名入口 + 栏目导航。“机场推荐”只作为栏目之一出现，主承接页仍是 /category/airports/。
const pageTitle = '机场巡查博客｜机场推荐、Clash教程、VPS与网络故障排查';
const pageDesc = `机场巡查博客整理${brandCount}家机场品牌与套餐资料、Clash客户端教程、VPS服务器知识及节点超时排查方法，帮助读者比较网络服务并解决连接问题。`;
const site = 'https://jichangxuncha.blog/';
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': site + '#website', url: site, name: '机场巡查博客', alternateName: 'jichangxuncha.blog', inLanguage: 'zh-CN', publisher: { '@id': site + '#org' },
      potentialAction: { '@type': 'SearchAction', target: site + 'search/?q={search_term_string}', 'query-input': 'required name=search_term_string' } },
    { '@type': 'Organization', '@id': site + '#org', name: '机场巡查博客', url: site, logo: site + 'logo-mark.png' },
    { '@type': 'WebPage', '@id': site + '#webpage', url: site, name: pageTitle, description: pageDesc, inLanguage: 'zh-CN', isPartOf: { '@id': site + '#website' }, about: { '@id': site + '#org' } },
    { '@type': 'FAQPage', '@id': site + '#faq', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<Layout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}/>
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <p class="mono hero-eye">INDEPENDENT NOTES · 持续巡查中</p>
        <h1>连接世界，<br/>从一次认真<br/>选择开始。</h1>
        <p class="hero-sub">整理专线机场资料、客户端教程与节点排查方法。<br/>让每一次选择，都多一份参考。</p>
        <a class="link" href="#latest">开始阅读 <span aria-hidden="true">↓</span></a>
        <p><a class="link" href="/knowledge/">网络知识库 →</a></p>
        <p><a href="/knowledge/client-comparison/">客户端怎么选</a> · <a href="/knowledge/#troubleshooting">节点故障排查</a> · <a href="/knowledge/#network">代理协议与原理</a></p>
      </div>
      <div class="hero-art"><DotField/></div>
    </section>

    <section class="topics" aria-label="栏目">
      {topics.map((t) => (
        <a class="topic" href={t.slug==='vps'?'/category/vps/':`/category/${t.slug}/`} data-reveal>
          <div class="topic-top mono"><span>{t.no}</span><span>{count(t)} 篇</span></div>
          <div class="topic-art"><Glyph slug={t.slug}/></div>
          <h2>{t.category}</h2>
          <p>{t.desc}</p>
        </a>
      ))}
    </section>

    <section class="sec" id="start">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">START HERE</span>
        <h2>从你的问题开始</h2>
        <p class="sec-lead">不知道先看哪篇？按你现在所处的阶段，直接找到对应的答案。</p>
      </div></div>
      <div class="sec-body stages" data-reveal>
        {stages.map((s) => (
          <div class="stage">
            <p class="mono stage-code">{s.code}</p>
            <h3>{s.title}</h3>
            <ul>
              {s.items.map(([label, href]) => <li><a href={href}>{label}<span aria-hidden="true">→</span></a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="sec" id="latest">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">LATEST NOTES</span>
        <h2>最近的巡查笔记</h2>
      </div></div>
      <div class="sec-body" data-reveal><PostList/></div>
    </section>

    <section class="sec">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">CHECKLIST</span>
        <h2>选之前，先过这三项</h2>
        <a class="link head-link" href="/category/airports/#checklist">读完整的七项清单 <span aria-hidden="true">→</span></a>
      </div></div>
      <ol class="sec-body checks" data-reveal>
        {checks.map(([head, text], i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{head}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">NETWORK TOOLS</span>
        <h2>先检查，再连接</h2>
      </div></div>
      <div class="sec-body" data-reveal>
        <a class="tool" href="/tools/">
          <div class="tool-flow" aria-hidden="true">
            <span class="tool-box">网页连通</span>
            <i></i>
            <span class="tool-box">下载测速</span>
          </div>
          <p>检查国内与跨境站点响应，测试当前网络的下载速率，帮助排查网页打不开和连接缓慢的问题。</p>
          <span class="tool-go">打开网络工具箱 <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <section class="sec" id="faq">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">FAQ</span>
        <h2>关于本站的常见问题</h2>
      </div></div>
      <div class="sec-body faq" data-reveal>
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">ABOUT</span>
        <h2>我们怎样整理资料</h2>
      </div></div>
      <div class="sec-body about" data-reveal>
        <p>品牌资料来自各品牌公开的套餐与说明，页面会标明哪些是品牌声明、哪些仍待确认；教程与排查文章依据客户端项目文档和网络协议规范整理。本站不做测速排名，也不替任何一家作性能保证。</p>
        <p>部分品牌入口是合作推广链接，点击后会先经过一个说明页，由你自己决定是否前往官网。</p>
        <p class="about-links"><a href="/editorial/">内容与编辑规范 →</a><a href="/disclosure/">推广关系说明 →</a><a href="/about/">关于本站 →</a></p>
      </div>
    </section>

    <section class="closing">
      <p><a class="link" href="/knowledge/">网络知识库：客户端教程、节点故障与协议原理 →</a></p>
      <p class="note">品牌资料、知识教程与实际测试分别说明；请结合自己的设备、网络和服务条款判断。</p>
    </section>
  </div>
</Layout>

<style>
  .hero{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center;min-height:calc(100svh - 65px);padding-block:clamp(36px,5vw,64px)}
  .hero-copy{grid-column:1/8;transition:opacity .8s,transform .9s cubic-bezier(.2,.7,.2,1)}
  .hero-art{grid-column:8/13;transition:opacity .8s .1s}
  :global(html.js:not(.is-ready)) .hero-copy{opacity:0;transform:translateY(16px)}
  :global(html.js:not(.is-ready)) .hero-art{opacity:0}
  .hero-eye{color:var(--muted);margin-bottom:clamp(20px,2.6vw,32px)}
  .hero h1{font-size:clamp(42px,6.2vw,92px);line-height:1.14;letter-spacing:-.015em}
  .hero-sub{margin:clamp(20px,2.6vw,32px) 0 20px;font-size:clamp(16px,1.35vw,18px);color:var(--muted)}
  @media(max-width:860px){
    .hero{display:block;min-height:0}
    .hero-art{margin-top:40px}
    .hero h1{font-size:clamp(40px,12.4vw,84px)}
    .hero-sub br{display:none}
  }

  .topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--ink)}
  .topic{display:block;padding:clamp(20px,2.4vw,32px);border-left:1px solid var(--line);transition:background .2s}
  .topic:first-child{border-left:0;padding-left:0}
  .topic:last-child{padding-right:0}
  .topic-top{display:flex;justify-content:space-between;color:var(--muted)}
  .topic-art{width:clamp(96px,10vw,140px);margin:clamp(28px,4vw,56px) 0}
  .topic h2{font-size:clamp(22px,2.2vw,30px);line-height:1.3;transition:color .15s}
  .topic p{margin-top:6px;font-size:15px;color:var(--muted)}
  .topic:hover h2{color:var(--accent)}
  @media(max-width:760px){
    .topics{grid-template-columns:1fr}
    .topic,.topic:first-child,.topic:last-child{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:18px;align-items:center;padding:20px 0;border-left:0;border-top:1px solid var(--line)}
    .topic:first-child{border-top:0}
    .topic-top{grid-column:1/-1;margin-bottom:12px}
    .topic-art{grid-row:2/4;width:72px;margin:0}
    .topic p{margin:0}
  }

  .head-link{margin-top:20px}
  .checks{border-top:1px solid var(--ink)}
  .checks li{display:grid;grid-template-columns:120px minmax(0,1fr);column-gap:24px;padding:clamp(20px,2.4vw,30px) 0;border-bottom:1px solid var(--line)}
  .checks .mono{grid-row:1/3;color:var(--accent);padding-top:.4em}
  .checks h3{font-size:clamp(20px,2vw,27px);line-height:1.35}
  .checks p{margin-top:6px;font-size:16px;color:var(--muted);max-width:36em}
  @media(max-width:700px){.checks li{grid-template-columns:44px minmax(0,1fr);column-gap:8px}}

  .tool{display:block;padding:clamp(24px,3.4vw,44px);background:var(--ink);color:var(--paper);transition:background .2s}
  .tool-flow{display:flex;align-items:center;gap:0;margin-bottom:clamp(24px,3vw,36px)}
  .tool-box{flex:none;padding:10px 14px;border:1px solid #5F6466;font:500 clamp(13px,1.4vw,16px) var(--head)}
  .tool-flow i{flex:1;min-width:24px;height:0;border-top:2px dotted #3FBF8F}
  .tool p{max-width:36em;font-size:16px;color:#C6C8C2}
  .tool-go{display:inline-block;margin-top:20px;font-weight:500;color:#3FBF8F;transition:transform .18s}
  .tool:hover .tool-go{transform:translateX(4px)}
  .closing{padding-block:0 clamp(40px,5vw,64px)}

  .sec-lead{margin-top:14px;font-size:15px;color:var(--muted);max-width:22em}
  .stages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:24px;border-top:1px solid var(--ink)}
  .stage{padding-top:clamp(18px,2vw,26px)}
  .stage-code{color:var(--accent)}
  .stage h3{margin:8px 0 10px;font-size:clamp(20px,2vw,26px);line-height:1.35}
  .stage ul{list-style:none;margin:0;padding:0}
  .stage li{border-top:1px solid var(--line)}
  .stage a{display:flex;justify-content:space-between;gap:12px;align-items:baseline;padding:12px 0;font-size:15px;line-height:1.6;transition:color .15s}
  .stage a span{flex:none;color:var(--muted);transition:transform .18s,color .15s}
  .stage a:hover{color:var(--accent)}
  .stage a:hover span{color:var(--accent);transform:translateX(3px)}
  @media(max-width:900px){.stages{grid-template-columns:1fr}.stage+.stage{margin-top:16px}}

  .faq{border-top:1px solid var(--ink)}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{display:flex;justify-content:space-between;gap:16px;padding:18px 0;font-size:clamp(16px,1.5vw,18px);font-weight:500;cursor:pointer;list-style:none}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";flex:none;color:var(--accent);font-family:var(--mono-f)}
  .faq details[open] summary::after{content:"−"}
  .faq p{padding:0 0 20px;font-size:15px;line-height:1.9;color:var(--muted);max-width:40em}

  .about{border-top:1px solid var(--ink);padding-top:clamp(18px,2vw,26px)}
  .about p{font-size:16px;line-height:1.9;max-width:40em}
  .about p+p{margin-top:12px}
  .about-links{display:flex;flex-wrap:wrap;gap:8px 24px;color:var(--accent)}
  .about-links a{min-height:36px;display:inline-flex;align-items:center}
</style>
