---
import Layout from '../layouts/Layout.astro';
import {posts} from '../data/posts';
---
<Layout><section class="hero"><div><div class="eyebrow">INDEPENDENT NOTES · 持续巡查中</div><h1>连接世界，<br/>从一次认真选择开始。</h1><p>记录机场体验，探索 VPS，整理订阅使用方法。<br/>让每一次选择，都多一份参考。</p><a class="button" href="#latest">开始阅读 <span>↗</span></a><span class="domain">jichangxuncha.blog</span></div><div class="radar"><div class="orbit o1"></div><div class="orbit o2"></div><div class="orbit o3"></div><div class="axis"></div><div class="center">巡<span>NETWORK OBSERVER</span></div><i class="dot d1"></i><i class="dot d2"></i><div class="radar-note">持续探索 · 保持连接</div><span class="coord">31° N / 121° E<br/>EXPLORING THE NETWORK</span></div></section><div class="topics">{[['01','机场推荐','线路体验与选购笔记','airports'],['02','VPS 探索','服务器与部署记录','vps'],['03','一元机场','低预算套餐观察','budget']].map(([n,t,d,s])=><a href={`/category/${s}/`}><span>{n}</span><div><h3>{t}</h3><p>{d}</p></div><b>↗</b></a>)}</div><section id="latest"><div class="section-head"><h2>最近的巡查笔记<span class="tiny"> / LATEST NOTES</span></h2><span>从这里开始了解 →</span></div><div class="cards">{posts.map((post,i)=><a class="card" href={`/posts/${post.slug}/`}><div class={`art ${i===1?'vps':i===2?'budget':''}`}><span>{['NETWORK / 01','SERVER / 02','BUDGET / 03'][i]}</span><b>{['◎','▤','¥'][i]}</b></div><div class="card-content"><span class="tag">{post.category} · 框架示例</span><h3>{post.title}</h3><p>{post.description}</p><div class="meta">{post.date} · {post.time}<span style="float:right">↗</span></div></div></a>)}</div></section><section class="subscription"><div><div class="eyebrow">SUBSCRIPTION DESK</div><h2>你的订阅，顺手管理。</h2><p>整理第三方订阅链接，生成客户端导入入口。<br/>适配 Clash / Shadowrocket 的日常使用流程。</p></div><a class="button" href="/subscriptions/">打开订阅工具 ↗</a></section><p class="notice">本站正在搭建中。当前文章为结构示例，真实评测与商家信息将在后续补充。</p></Layout>
<style>.hero{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:40px;padding:65px 0 55px}.hero h1{margin:22px 0}.hero p{font-size:16px}.hero .button{gap:35px;margin-top:12px}.domain{font-size:11px;color:#899087;margin-left:18px}.radar{height:340px;background:#e9eee3;position:relative;overflow:hidden;border-radius:50% 50% 6px 6px}.orbit{position:absolute;border:1px solid #bdcfb8;border-radius:50%;left:50%;top:49%;transform:translate(-50%,-50%)}.o1{width:130px;height:130px}.o2{width:240px;height:240px}.o3{width:350px;height:350px}.axis{position:absolute;left:50%;top:0;height:100%;border-left:1px dashed #c8d5c2}.center{position:absolute;left:50%;top:43%;transform:translate(-50%,-50%);font-size:49px;color:#35644b;text-align:center}.center span{display:block;font-size:8px;letter-spacing:2px;white-space:nowrap}.dot{width:10px;height:10px;background:#4d8263;border:3px solid #d4e2cb;box-shadow:0 0 0 4px #4d826322;border-radius:50%;position:absolute}.d1{left:27%;top:28%}.d2{right:19%;top:60%}.radar-note{position:absolute;bottom:55px;left:30px;color:#486b4c;font-size:12px}.coord{position:absolute;bottom:20px;left:30px;font-size:8px;letter-spacing:2px;color:#86937d}.topics{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #dce2d8;border-bottom:1px solid #dce2d8}.topics a{display:flex;align-items:center;gap:18px;padding:25px 20px}.topics a+a{border-left:1px solid #dce2d8}.topics a>span{font-size:12px;color:#87977d}.topics h3{font-size:17px;margin-bottom:4px}.topics p{font-size:12px;margin:0}.topics b{margin-left:auto;font-weight:400}.tiny{font-size:10px;letter-spacing:2px;color:#8c968a;margin-left:15px}.subscription{margin-top:45px;padding:34px;background:#e9eee3;display:flex;align-items:center;justify-content:space-between;border-radius:8px}.subscription h2{margin:12px 0}.subscription p{margin:0;font-size:14px}.notice{margin-top:24px}@media(max-width:760px){.hero{grid-template-columns:1fr;padding:40px 0}.radar{height:260px}.topics{grid-template-columns:1fr}.topics a+a{border-left:0;border-top:1px solid #dce2d8}.subscription{align-items:flex-start;flex-direction:column;gap:20px}.tiny{display:none}.section-head>span{display:none}.domain{display:none}}</style>
