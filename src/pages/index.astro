---
import Layout from '../layouts/Layout.astro';
import DotField from '../components/DotField.astro';
import Glyph from '../components/Glyph.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../data/posts';
import { topics } from '../data/site';

// 清单直接取自第一篇文章，改文章这里就跟着变。
const guide = posts[0];
const checks = guide.body.filter((t) => t.startsWith('看')).map((t) => t.split('：'));
const count = (t) => posts.filter((p) => p.category === t.category).length;
---
<Layout>
  <div class="wrap">
    <section class="hero">
      <div class="hero-copy">
        <p class="mono hero-eye">INDEPENDENT NOTES · 持续巡查中</p>
        <h1>连接世界，<br/>从一次认真<br/>选择开始。</h1>
        <p class="hero-sub">记录机场体验，探索 VPS，整理订阅使用方法。<br/>让每一次选择，都多一份参考。</p>
        <a class="link" href="#latest">开始阅读 <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-art"><DotField/></div>
    </section>

    <section class="topics" aria-label="栏目">
      {topics.map((t) => (
        <a class="topic" href={t.slug==='vps'?'/catagory/vps/':`/category/${t.slug}/`} data-reveal>
          <div class="topic-top mono"><span>{t.no}</span><span>{count(t)} 篇</span></div>
          <div class="topic-art"><Glyph slug={t.slug}/></div>
          <h2>{t.category}</h2>
          <p>{t.desc}</p>
        </a>
      ))}
    </section>

    <section class="sec" id="latest">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">LATEST NOTES</span>
        <h2>最近的巡查笔记</h2>
      </div></div>
      <div class="sec-body" data-reveal><PostList/></div>
    </section>

    <section class="sec">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">CHECKLIST</span>
        <h2>选之前，先过这三项</h2>
        <a class="link head-link" href={`/posts/${guide.slug}/`}>读完整清单 <span aria-hidden="true">→</span></a>
      </div></div>
      <ol class="sec-body checks" data-reveal>
        {checks.map(([head, text], i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{head}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sec">
      <div class="sec-head"><div class="sec-sticky">
        <span class="mono">NETWORK TOOLS</span>
        <h2>先检查，再连接</h2>
      </div></div>
      <div class="sec-body" data-reveal>
        <a class="tool" href="/tools/">
          <div class="tool-flow" aria-hidden="true">
            <span class="tool-box">网页连通</span>
            <i></i>
            <span class="tool-box">下载测速</span>
          </div>
          <p>检查国内与跨境站点响应，测试当前网络的下载速率，帮助排查网页打不开和连接缓慢的问题。</p>
          <span class="tool-go">打开网络工具箱 <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>

    <section class="closing">
      <p><a class="link" href="/knowledge/">网络知识库：客户端教程、节点故障与协议原理 →</a></p>
      <p class="note">品牌资料、知识教程与实际测试分别说明；请结合自己的设备、网络和服务条款判断。</p>
    </section>
  </div>
</Layout>

<style>
  .hero{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center;min-height:calc(100svh - 65px);padding-block:clamp(36px,5vw,64px)}
  .hero-copy{grid-column:1/8;transition:opacity .8s,transform .9s cubic-bezier(.2,.7,.2,1)}
  .hero-art{grid-column:8/13;transition:opacity .8s .1s}
  :global(html.js:not(.is-ready)) .hero-copy{opacity:0;transform:translateY(16px)}
  :global(html.js:not(.is-ready)) .hero-art{opacity:0}
  .hero-eye{color:var(--muted);margin-bottom:clamp(20px,2.6vw,32px)}
  .hero h1{font-size:clamp(42px,6.2vw,92px);line-height:1.14;letter-spacing:-.015em}
  .hero-sub{margin:clamp(20px,2.6vw,32px) 0 20px;font-size:clamp(16px,1.35vw,18px);color:var(--muted)}
  @media(max-width:860px){
    .hero{display:block;min-height:0}
    .hero-art{margin-top:40px}
    .hero h1{font-size:clamp(40px,12.4vw,84px)}
    .hero-sub br{display:none}
  }

  .topics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid var(--ink)}
  .topic{display:block;padding:clamp(20px,2.4vw,32px);border-left:1px solid var(--line);transition:background .2s}
  .topic:first-child{border-left:0;padding-left:0}
  .topic:last-child{padding-right:0}
  .topic-top{display:flex;justify-content:space-between;color:var(--muted)}
  .topic-art{width:clamp(96px,10vw,140px);margin:clamp(28px,4vw,56px) 0}
  .topic h2{font-size:clamp(22px,2.2vw,30px);line-height:1.3;transition:color .15s}
  .topic p{margin-top:6px;font-size:15px;color:var(--muted)}
  .topic:hover h2{color:var(--accent)}
  @media(max-width:760px){
    .topics{grid-template-columns:1fr}
    .topic,.topic:first-child,.topic:last-child{display:grid;grid-template-columns:72px minmax(0,1fr);column-gap:18px;align-items:center;padding:20px 0;border-left:0;border-top:1px solid var(--line)}
    .topic:first-child{border-top:0}
    .topic-top{grid-column:1/-1;margin-bottom:12px}
    .topic-art{grid-row:2/4;width:72px;margin:0}
    .topic p{margin:0}
  }

  .head-link{margin-top:20px}
  .checks{border-top:1px solid var(--ink)}
  .checks li{display:grid;grid-template-columns:120px minmax(0,1fr);column-gap:24px;padding:clamp(20px,2.4vw,30px) 0;border-bottom:1px solid var(--line)}
  .checks .mono{grid-row:1/3;color:var(--accent);padding-top:.4em}
  .checks h3{font-size:clamp(20px,2vw,27px);line-height:1.35}
  .checks p{margin-top:6px;font-size:16px;color:var(--muted);max-width:36em}
  @media(max-width:700px){.checks li{grid-template-columns:44px minmax(0,1fr);column-gap:8px}}

  .tool{display:block;padding:clamp(24px,3.4vw,44px);background:var(--ink);color:var(--paper);transition:background .2s}
  .tool-flow{display:flex;align-items:center;gap:0;margin-bottom:clamp(24px,3vw,36px)}
  .tool-box{flex:none;padding:10px 14px;border:1px solid #5F6466;font:500 clamp(13px,1.4vw,16px) var(--head)}
  .tool-flow i{flex:1;min-width:24px;height:0;border-top:2px dotted #3FBF8F}
  .tool p{max-width:36em;font-size:16px;color:#C6C8C2}
  .tool-go{display:inline-block;margin-top:20px;font-weight:500;color:#3FBF8F;transition:transform .18s}
  .tool:hover .tool-go{transform:translateX(4px)}
  .closing{padding-block:0 clamp(40px,5vw,64px)}
</style>
