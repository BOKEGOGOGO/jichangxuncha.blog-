---
import Layout from '../layouts/Layout.astro';
import AirfieldChart from '../components/AirfieldChart.astro';
import Board from '../components/Board.astro';
import PosterArt from '../components/PosterArt.astro';
import { posts } from '../data/posts';
import { gates } from '../data/site';

// 清单直接取自第一篇文章，改文章这里就跟着变。
const guide = posts[0];
const checks = guide.body.filter((t) => t.startsWith('看')).map((t) => t.split('：'));
const count = (g) => posts.filter((p) => p.category === g.category).length;
const ticker = ['机场推荐', 'VPS 探索', '一元机场', '订阅工具', '保持观察，认真记录', 'KEEP WATCH'];
const bars = [3, 1, 2, 1, 4, 1, 1, 3, 2, 1, 3, 1, 4, 2, 1, 1, 3, 1, 2, 4, 1, 2, 1, 3, 1, 1, 4, 2, 1, 3, 2, 1];
let barX = 0;
---
<Layout>
  <section class="hero">
    <div class="hero-chart"><AirfieldChart/></div>
    <div class="hero-copy">
      <p class="hero-eye mono"><i></i>INDEPENDENT NOTES · 持续巡查中</p>
      <h1 class="big">
        <span class="ln"><span>连接世界，</span></span>
        <span class="ln"><span>从一次认真</span></span>
        <span class="ln"><span>选择开始。</span></span>
      </h1>
      <div class="hero-foot">
        <p>记录机场体验，探索 VPS，整理订阅使用方法。<br/>让每一次选择，都多一份参考。</p>
        <a class="hero-cta" href="#latest">开始阅读 <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <div class="tick" aria-hidden="true">
    <div class="tick-run">
      {[0, 1].map(() => <div>{ticker.map((t) => <span>{t}<b>→</b></span>)}{ticker.map((t) => <span>{t}<b>→</b></span>)}</div>)}
    </div>
  </div>

  <section class="depart" id="latest">
    <div class="depart-head">
      <div class="depart-title">
        <span class="picto" aria-hidden="true"><svg viewBox="0 0 64 64"><path d="M8 50h48v5H8ZM11 33l5-3 9 3 7-5-15-12 6-3 21 9 9-5c3-2 7-1 8 1 1 3 0 5-3 7L24 44Z"/></svg></span>
        <div>
          <h2 class="big">最近的巡查笔记</h2>
          <p class="mono">DEPARTURES / LATEST NOTES</p>
        </div>
      </div>
      <div class="depart-clock"><span class="mono">本地时间</span><time id="board-clock">--:--:--</time></div>
    </div>
    <Board/>
  </section>

  <section class="gates">
    <div class="gates-head" data-reveal>
      <p class="mono">GATES / 登机口</p>
      <h2 class="big">三个登机口，<br/>按需要走。</h2>
    </div>
    <div class="gates-grid">
      {gates.map((g, i) => (
        <a class={`poster poster-${g.key}`} href={`/category/${g.slug}/`} data-reveal style={`--d:${i}`}>
          <PosterArt kind={g.key}/>
          <div class="poster-text">
            <span class="poster-key">{g.key}</span>
            <h3 class="big">{g.name}</h3>
            <p>{g.desc}</p>
          </div>
          <span class="poster-tag mono">{g.en} · {count(g)} 篇 →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="list">
    <div class="list-side">
      <div class="list-sticky" data-reveal>
        <p class="mono">PRE-FLIGHT / 巡查清单</p>
        <h2 class="big">选之前，<br/>先过这三项。</h2>
        <svg class="stamp" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="stamp-c" d="M100 100m-74 0a74 74 0 1 1 148 0a74 74 0 1 1-148 0"/></defs>
          <circle cx="100" cy="100" r="94" fill="none" stroke="currentColor" stroke-width="5"/>
          <circle cx="100" cy="100" r="56" fill="none" stroke="currentColor" stroke-width="2.5"/>
          <text class="stamp-ring"><textPath href="#stamp-c" textLength="456" lengthAdjust="spacing">PATROL LOG · 保持观察 · 认真记录 ·</textPath></text>
          <text x="100" y="100" text-anchor="middle" dominant-baseline="central" class="stamp-big">巡</text>
        </svg>
        <a class="list-more" href={`/posts/${guide.slug}/`}>读完整清单 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <ol class="list-items">
      {checks.map(([head, text], i) => (
        <li data-reveal>
          <span class="list-no big">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="big">{head}</h3>
            <p>{text}</p>
          </div>
          <svg class="list-tick" viewBox="0 0 48 48" aria-hidden="true"><rect x="2" y="2" width="44" height="44" fill="none" stroke="currentColor" stroke-width="3"/><path d="M11 25l9 9 17-20" fill="none" stroke="currentColor" stroke-width="6" pathLength="1"/></svg>
        </li>
      ))}
    </ol>
  </section>

  <section class="desk">
    <a class="pass" href="/subscriptions/" data-reveal>
      <div class="pass-main">
        <div class="pass-top mono"><span>BOARDING PASS</span><span>SUBSCRIPTION DESK</span></div>
        <h2 class="big">你的订阅，<br/>顺手管理。</h2>
        <div class="pass-route">
          <div><small class="mono">FROM</small><strong class="big">订阅链接</strong></div>
          <svg viewBox="-34 -26 68 52" aria-hidden="true"><path d="M30 0C30-3 24-4 18-4H6L-6-24h-7l7 20h-14l-6-8h-5l3 12-3 12h5l6-8H-6l-7 20h7L6 4h12c6 0 12-1 12-4Z"/></svg>
          <div><small class="mono">TO</small><strong class="big">Clash / Shadowrocket</strong></div>
        </div>
        <p>整理第三方订阅链接，生成客户端导入入口。链接只在当前页面处理，不上传、不保存。</p>
      </div>
      <div class="pass-stub">
        <div class="pass-field"><small class="mono">GATE</small><strong class="big">S</strong></div>
        <svg class="pass-bars" viewBox="0 0 120 56" preserveAspectRatio="none" aria-hidden="true">
          {bars.map((w) => { const x = barX; barX += w + 1.6; return <rect x={x} width={w} height="56"/>; })}
        </svg>
        <span class="pass-cta">打开订阅工具 <span aria-hidden="true">→</span></span>
      </div>
    </a>
  </section>

  <aside class="notam"><b>NOTAM</b><span>本站正在搭建中。当前文章为结构示例，真实评测与商家信息将在后续补充。</span></aside>
</Layout>

<style>
  /* Hero */
  .hero{position:relative;background:var(--signal);min-height:calc(100svh - 60px);overflow:hidden;display:flex}
  .hero-chart{position:absolute;right:-2vw;top:50%;width:min(62vw,calc((100svh - 60px)*1.2));transform:translateY(-50%)}
  .hero-chart :global(.chart){display:block;width:100%;height:auto;overflow:visible}
  .hero-copy{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:space-between;gap:28px;padding:clamp(20px,3vw,40px) var(--gutter);width:100%;pointer-events:none}
  .hero-copy a{pointer-events:auto}
  .hero-eye{display:flex;align-items:center;gap:10px}
  .hero-eye i{width:10px;height:10px;background:var(--stop);border-radius:50%;animation:blink 1.4s steps(2) infinite}
  .hero h1{font-size:clamp(62px,min(9.2vw,17vh),172px);line-height:1.06;margin-top:auto}
  .ln{display:block;overflow:hidden;padding-bottom:.06em}
  .ln>span{display:block;transition:transform .9s cubic-bezier(.2,.8,.2,1)}
  .ln:nth-child(2)>span{transition-delay:.08s}.ln:nth-child(3)>span{transition-delay:.16s}
  :global(html.js:not(.is-ready)) .ln>span{transform:translateY(112%)}
  .hero-chart{transition:opacity .8s .15s,translate .9s cubic-bezier(.2,.8,.2,1) .15s}
  :global(html.js:not(.is-ready)) .hero-chart{opacity:0;translate:70px 0}
  .hero-foot{display:flex;align-items:flex-end;gap:clamp(20px,3vw,44px);flex-wrap:wrap}
  .hero-foot p{font-size:16px;font-weight:600;line-height:1.75}
  .hero-cta{display:inline-flex;align-items:center;gap:30px;min-height:56px;padding:0 24px;background:var(--ink);color:var(--signal);font:900 21px/1 var(--display);transition:background .15s,color .15s}
  .hero-cta:hover{background:var(--taxi);color:#fff}
  .hero-cta span{transition:transform .18s}.hero-cta:hover span{transform:translateY(4px)}
  @media(max-width:1023px){
    .hero{flex-direction:column;min-height:0}
    .hero-chart{position:relative;order:2;right:auto;top:auto;width:112%;margin:-5% -6% -3% -6%;transform:none}
    .hero-copy{order:1;gap:18px}
    .hero h1{font-size:min(18.2vw,132px);margin-top:8px}
  }

  /* 跑马灯 */
  .tick{background:var(--ink);color:var(--signal);overflow:hidden;border-top:12px solid transparent;border-image:var(--hazard) 12;font:900 21px/1 var(--display)}
  .tick-run{display:flex;width:max-content;animation:tick 42s linear infinite}
  .tick-run>div{display:flex}
  .tick span{display:flex;align-items:center;gap:30px;padding:17px 0 17px 30px;white-space:nowrap}
  .tick b{font-weight:800;color:var(--paper)}
  @keyframes tick{to{transform:translateX(-50%)}}

  /* 出发屏 */
  .depart{background:var(--ink);color:var(--paper);padding-top:clamp(36px,6vw,84px)}
  .depart-head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;padding:0 var(--gutter) clamp(24px,3vw,40px)}
  .depart-title{display:flex;align-items:center;gap:clamp(14px,2vw,26px)}
  .picto{flex:none;width:clamp(58px,8vw,112px);aspect-ratio:1;background:var(--signal);padding:clamp(6px,.9vw,12px)}
  .picto svg{display:block;width:100%;height:auto;aspect-ratio:1;fill:var(--ink)}
  .depart h2{font-size:clamp(34px,6vw,92px);white-space:nowrap}
  .depart-title .mono{color:var(--dim);margin-top:8px}
  .depart-clock{text-align:right}
  .depart-clock .mono{display:block;color:var(--dim)}
  .depart-clock time{font:500 clamp(24px,3vw,38px)/1.2 var(--mono);color:var(--signal)}
  @media(max-width:560px){.depart-clock{text-align:left}}

  /* 登机口海报 */
  .gates{background:var(--concrete);padding:clamp(48px,8vw,120px) var(--gutter)}
  .gates-head{margin-bottom:clamp(28px,4vw,56px)}
  .gates-head .mono{color:var(--ash);margin-bottom:12px}
  .gates-head h2{font-size:clamp(40px,6.6vw,104px)}
  .gates-grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-rows:minmax(0,auto);gap:clamp(10px,1.4vw,20px)}
  .poster{position:relative;display:block;overflow:hidden;color:var(--ink)}
  .poster-A{grid-column:1/7;grid-row:1/3;min-height:clamp(560px,62vw,920px);color:#fff}
  .poster-V{grid-column:7/13;margin-top:clamp(0px,5vw,72px);min-height:clamp(300px,30vw,440px);color:#fff}
  .poster-Y{grid-column:7/13;min-height:clamp(300px,30vw,440px);margin-right:clamp(0px,6vw,90px)}
  .poster-text{position:relative;padding:clamp(18px,2.4vw,34px);max-width:64%}
  .poster-A .poster-text{max-width:100%}
  .poster-key{display:grid;place-items:center;width:48px;height:48px;margin-bottom:14px;background:var(--ink);color:var(--signal);font:800 32px/1 var(--display)}
  .poster h3{font-size:clamp(34px,4.6vw,72px)}
  .poster-text p{margin-top:6px;font-weight:600;font-size:15px}
  .poster-tag{position:absolute;left:clamp(18px,2.4vw,34px);bottom:clamp(14px,2vw,26px);padding:7px 11px;background:var(--ink);color:var(--paper);transition:background .15s,color .15s}
  .poster:hover .poster-tag{background:var(--paper);color:var(--ink)}
  .poster:hover :global(.art-coin){transform:translateY(-34px)}
  .poster:hover :global(.art-fly){transform:translate(740px,40px) rotate(-10deg) scale(1.3)}
  .poster:hover :global(.art-sun){transform:translateY(-26px)}
  @media(max-width:760px){
    .gates-grid{display:flex;flex-direction:column}
    .poster-A{min-height:600px}
    .poster-V,.poster-Y{min-height:420px;margin:0}
    .poster-V .poster-text,.poster-Y .poster-text{max-width:90%}
    .poster-V{background:var(--stop)}
    .poster-V :global(.art){top:auto;bottom:0;height:62%}
  }

  /* 清单 */
  .list{display:grid;grid-template-columns:5fr 7fr;background:var(--paper)}
  .list-side{padding:clamp(40px,6vw,88px) var(--gutter);border-right:2px solid var(--ink)}
  .list-sticky{position:sticky;top:96px}
  .list-sticky .mono{color:var(--ash);margin-bottom:12px}
  .list h2{font-size:clamp(38px,5.2vw,84px)}
  .stamp{display:block;width:clamp(128px,14vw,190px);margin:clamp(24px,3vw,44px) 0;color:var(--stop);rotate:-11deg}
  .stamp-ring{font:800 20px var(--display);fill:currentColor}
  .stamp-big{font:900 66px var(--display);fill:currentColor}
  .list-more{display:inline-flex;align-items:center;gap:18px;min-height:48px;font-weight:800;font-size:16px;border-bottom:3px solid var(--ink);transition:gap .18s,color .15s}
  .list-more:hover{gap:30px;color:var(--taxi);border-color:var(--taxi)}
  .list-items li{display:grid;grid-template-columns:clamp(84px,12vw,190px) minmax(0,1fr) 44px;gap:clamp(12px,2vw,26px);align-items:start;padding:clamp(28px,4vw,60px) var(--gutter);border-bottom:2px solid var(--ink)}
  .list-items li:last-child{border-bottom:0}
  .list-no{font-size:clamp(64px,9.5vw,152px);line-height:.82}
  .list-items h3{font-size:clamp(30px,3.6vw,58px);margin-bottom:10px}
  .list-items p{max-width:32em;font-size:17px;color:#33322E}
  .list-tick{width:44px;height:44px;color:var(--ink)}
  .list-tick path{stroke-dasharray:1;stroke-dashoffset:1;stroke:var(--stop);transition:stroke-dashoffset .5s .45s}
  .list-items li:global(.in) .list-tick path{stroke-dashoffset:0}
  :global(html:not(.js)) .list-tick path{stroke-dashoffset:0}
  @media(max-width:860px){
    .list{grid-template-columns:1fr}
    .list-side{border-right:0;border-bottom:2px solid var(--ink)}
    .list-sticky{position:relative;top:auto}
    .stamp{position:absolute;right:0;top:-10px;margin:0;width:104px}
    .list-more{margin-top:20px}
  }
  @media(max-width:520px){.list-items li{grid-template-columns:minmax(0,1fr) 40px}.list-no{grid-column:1/-1}}

  /* 登机牌 */
  .desk{background:var(--taxi);padding:clamp(40px,7vw,104px) var(--gutter)}
  .pass{--notch:14px;display:grid;grid-template-columns:1fr minmax(220px,300px);max-width:1240px;margin:auto;background:var(--paper);color:var(--ink);rotate:-1.3deg;transition:rotate .4s cubic-bezier(.2,.8,.2,1)}
  .pass:hover{rotate:0deg}
  .pass-main{padding:0 0 clamp(20px,3vw,36px)}
  .pass-main>*:not(.pass-top){margin-inline:clamp(18px,3vw,40px)}
  .pass-top{display:flex;justify-content:space-between;padding:12px clamp(18px,3vw,40px);background:var(--ink);color:var(--signal);margin-bottom:clamp(20px,3vw,38px)}
  .pass h2{font-size:clamp(42px,6.8vw,108px)}
  .pass-route{display:flex;align-items:center;gap:clamp(12px,2vw,28px);flex-wrap:wrap;margin-block:clamp(20px,3vw,36px) 14px;padding-top:16px;border-top:2px solid var(--ink)}
  .pass-route svg{width:44px;fill:var(--taxi);flex:none}
  .pass-route small{display:block;color:var(--ash)}
  .pass-route strong{font-size:clamp(21px,2.4vw,34px)}
  .pass-main>p{font-size:15px;max-width:38em}
  .pass-stub{display:flex;flex-direction:column;justify-content:space-between;gap:18px;padding:clamp(18px,2.4vw,30px);border-left:3px dashed var(--ink);position:relative}
  .pass-stub::before,.pass-stub::after{content:"";position:absolute;left:calc(var(--notch)*-1 - 1.5px);width:calc(var(--notch)*2);height:calc(var(--notch)*2);border-radius:50%;background:var(--taxi)}
  .pass-stub::before{top:calc(var(--notch)*-1)}.pass-stub::after{bottom:calc(var(--notch)*-1)}
  .pass-field small{display:block;color:var(--ash)}
  .pass-field strong{font-size:clamp(76px,9vw,132px);line-height:.95}
  .pass-bars{display:block;width:100%;height:70px;fill:var(--ink)}
  .pass-cta{display:flex;justify-content:space-between;align-items:center;min-height:52px;padding:0 16px;background:var(--signal);font:900 19px/1 var(--display);transition:background .15s,color .15s}
  .pass:hover .pass-cta{background:var(--ink);color:var(--signal)}
  @media(max-width:760px){
    .pass{grid-template-columns:1fr;rotate:0deg}
    .pass-stub{border-left:0;border-top:3px dashed var(--ink)}
    .pass-stub::before,.pass-stub::after{top:calc(var(--notch)*-1 - 1.5px);bottom:auto}
    .pass-stub::before{left:calc(var(--notch)*-1)}.pass-stub::after{left:auto;right:calc(var(--notch)*-1)}
    .pass-field strong{font-size:72px}
  }
</style>
