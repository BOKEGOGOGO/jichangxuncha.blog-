---
import Layout from '../../layouts/Layout.astro';
import PosterArt from '../../components/PosterArt.astro';
import { posts } from '../../data/posts';
import { gateOf, flightNo } from '../../data/site';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const i = posts.indexOf(post);
const gate = gateOf(post.category);
const next = posts[(i + 1) % posts.length];
const nextGate = gateOf(next.category);
// “看线路：……”这样的段落拆成小标题和正文
const blocks = post.body.map((t) => {
  const [head, ...rest] = t.split('：');
  return rest.length && head.length <= 6 ? { head, text: rest.join('：') } : { text: t };
});
---
<Layout title={post.title} description={post.description}>
  <div class="taxi" id="taxi" aria-hidden="true"><i></i></div>
  <article>
    <header class={`band band-${gate.tone}`}>
      <div class="band-art"><PosterArt kind={gate.key}/></div>
      <a class="back" href="/">← 返回首页</a>
      <div class="band-text">
        <span class="mono">{flightNo(i)} · GATE {gate.key} · {post.category}</span>
        <h1><span>{post.title}</span></h1>
      </div>
    </header>
    <div class="strip mono">
      <div><small>航班</small>{flightNo(i)}</div>
      <div><small>日期</small>{post.date}</div>
      <div><small>阅读</small>{post.time}</div>
      <div><small>状态</small>示例文章</div>
    </div>
    <div class="body">
      <p class="lede">{post.description}</p>
      <div class="flow">
        {blocks.map((b) => b.head
          ? <section class="point"><h2>{b.head}</h2><p>{b.text}</p></section>
          : <p>{b.text}</p>)}
      </div>
    </div>
  </article>
  <a class="next" href={`/posts/${next.slug}/`}>
    <span class="mono">下一班 NEXT · {flightNo(posts.indexOf(next))} · GATE {nextGate.key}</span>
    <strong>{next.title}</strong>
    <b aria-hidden="true">→</b>
  </a>
</Layout>
<style>
  .taxi{position:fixed;left:0;right:0;top:60px;height:5px;z-index:39;background:rgba(17,17,16,.16)}
  .taxi i{display:block;height:100%;width:calc(var(--p,0)*100%);background:var(--signal);box-shadow:0 0 0 1px var(--ink)}
  @media(max-width:760px){.taxi{top:0}}
  .strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--ink);color:var(--signal)}
  .strip>div{padding:14px var(--gutter);border-left:1px solid var(--line)}
  .strip>div:first-child{border-left:0}
  .strip small{display:block;color:var(--dim);font:inherit;font-size:11px}
  @media(max-width:560px){.strip{grid-template-columns:1fr 1fr}.strip>div:nth-child(3){border-left:0}}
  .body{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,5vw,80px);padding:clamp(40px,6vw,96px) var(--gutter)}
  .lede{font:900 clamp(26px,3.2vw,48px)/1.28 var(--display)}
  .flow{max-width:36em}
  .flow p{font-size:18px;line-height:1.9;margin-bottom:1.3em}
  .point{padding-top:18px;border-top:3px solid var(--ink);margin-top:34px}
  .point h2{font:900 clamp(26px,2.8vw,38px)/1.2 var(--display);margin-bottom:10px}
  @media(max-width:860px){.body{grid-template-columns:1fr}}
  .next{display:grid;grid-template-columns:1fr auto;gap:8px 20px;align-items:end;padding:clamp(28px,4vw,56px) var(--gutter);background:var(--signal);transition:background .15s,color .15s}
  .next .mono{grid-column:1/-1}
  .next strong{font:900 clamp(28px,4.6vw,72px)/1.12 var(--display)}
  .next b{font:800 clamp(40px,6vw,88px)/1 var(--display);transition:transform .2s}
  .next:hover{background:var(--ink);color:var(--signal)}
  .next:hover b{transform:translateX(8px)}
</style>
