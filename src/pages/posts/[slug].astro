---
import Layout from '../../layouts/Layout.astro';
import BrandDossier from '../../components/BrandDossier.astro';
import { additionalBrands } from '../../data/additional-brands';
import Feimao from '../../components/Feimao.astro';
import Weifeng from '../../components/Weifeng.astro';
import Muguang from '../../components/Muguang.astro';
import FlyV from '../../components/FlyV.astro';
import Glyph from '../../components/Glyph.astro';
import { posts } from '../../data/posts';
import { topicOf } from '../../data/site';
export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const brand = additionalBrands.find(b=>b.slug===post.slug);
const topic = topicOf(post.category);
const next = posts[(posts.indexOf(post) + 1) % posts.length];
// 结构化数据：只描述页面上真实存在的内容（标题、摘要、发布与修改日期、所属栏目）
const site = 'https://jichangxuncha.blog';
const url = `${site}/posts/${post.slug}/`;
const crumbHref = topic.slug === 'vps' ? '/category/vps/' : `/category/${topic.slug}/`;
const graph = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', '@id': url + '#article', headline: post.title, description: post.description, datePublished: post.date, dateModified: post.updated ?? post.date, inLanguage: 'zh-CN', mainEntityOfPage: url,
    author: { '@type': 'Organization', name: '机场巡查博客', url: site + '/' }, publisher: { '@type': 'Organization', name: '机场巡查博客', url: site + '/' }, isPartOf: { '@id': site + '/#website' } },
  { '@type': 'BreadcrumbList', '@id': url + '#breadcrumb', itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: post.category, item: site + crumbHref },
    { '@type': 'ListItem', position: 3, name: post.title, item: url } ] },
] };
// 品牌页底部的延伸阅读：买之前、连上、出问题各一篇，外加回到全部品牌对照
const brandReading = [
  ['返回机场推荐：对照全部品牌的套餐与线路', '/category/airports/'],
  ['机场客户端怎么用：官方客户端六步连上', '/knowledge/client-comparison/'],
  ['机场月付还是年付？按用量算真实成本', '/knowledge/plan-costs/'],
  ['机场节点全部超时怎么办？分层排查方法', '/knowledge/node-timeout/'],
];
// “看线路：……”这样的段落拆成小标题和正文
const blocks = post.body.map((t) => {
  const [head, ...rest] = t.split('：');
  return rest.length && head.length <= 6 ? { head, text: rest.join('：') } : { text: t };
});
---
<Layout title={post.title} description={post.description}>
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')}/>
  <div class="bar" id="progress" aria-hidden="true"></div>
  <article class="wrap">
    <header class="page-head">
      <a class="mono" href={topic.slug==='vps'?'/category/vps/':`/category/${topic.slug}/`}>← {post.category}</a>
      <h1>{post.title}</h1>
    </header>
    <div class="sec art">
      <aside class="sec-head"><div class="sec-sticky">
        <div class="art-glyph"><Glyph slug={topic.slug}/></div>
        <dl class="mono">
          <dt>日期</dt><dd>{post.date}</dd>
          <dt>阅读</dt><dd>{post.time}</dd>
          <dt>状态</dt><dd>{post.status ?? '示例文章'}</dd>
        </dl>
      </div></aside>
      <div class="sec-body flow">
        <p class="lede">{post.description}</p>
        {post.category === '机场推荐' && <div class="brand-network-check"><p>校园网、办公网与家庭宽带的连接条件可能不同。购买或排查节点问题前，先结合你的网络环境查看建议。</p><a href="/tools/#diagnose">检查我的网络是否限制代理 →</a></div>}
        {post.slug === 'flyv' ? <FlyV/> : post.slug === 'muguang' ? <Muguang/> : post.slug === 'weifeng' ? <Weifeng/> : post.slug === 'feimao' ? <Feimao/> : brand ? <BrandDossier brand={brand}/> : blocks.map((b) => b.head
          ? <section><h2>{b.head}</h2><p>{b.text}</p></section>
          : <p>{b.text}</p>)}
        {post.category === '机场推荐' && <section><h2>继续阅读</h2>{brandReading.map(([label, href]) => <p><a href={href}>{label} →</a></p>)}</section>}
        {post.slug === 'vps-checklist' && <section><h2>按待确认的问题继续阅读</h2><p><a href="/vps/guides/how-to-choose-vps/">应用资源与配置选择 →</a></p><p><a href="/vps/guides/regions-and-routing/">机房地区与业务依赖 →</a></p><p><a href="/knowledge/vps-maintenance/">维护、安全与恢复清单 →</a></p><p><a href="/vps/guides/vps-vs-airport/">自建VPS与现成服务的责任比较 →</a></p></section>}
      </div>
    </div>
    <a class="next" href={`/posts/${next.slug}/`}>
      <span class="mono">下一篇</span>
      <strong>{next.title}</strong>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </article>
</Layout>
<style>
  .bar{position:fixed;left:0;top:0;z-index:50;height:2px;width:100%;background:var(--accent);transform:scaleX(var(--p,0));transform-origin:0 50%}
  .page-head a{transition:color .15s}
  .page-head a:hover{color:var(--accent)}
  .art-glyph{width:96px;margin-bottom:24px}
  dl{display:grid;grid-template-columns:48px 1fr;gap:4px 0;margin:0;color:var(--muted)}
  dd{margin:0;color:var(--ink)}
  .brand-network-check{padding:20px 24px;margin-bottom:28px;border-left:2px solid var(--accent);background:#0b7a5508}.flow .brand-network-check p{font-size:14px;margin-bottom:10px}.brand-network-check a{display:inline-block;padding:8px 0;border-bottom:1px solid var(--accent);color:var(--accent);font-size:15px}
  .flow{max-width:42em}
  .lede{font:500 clamp(20px,2vw,26px)/1.5 var(--head);margin-bottom:32px}
  .flow p{font-size:17px;line-height:1.9;margin-bottom:1.2em}
  .flow .lede{font-size:clamp(20px,2vw,26px);line-height:1.5}
  .flow section{padding-top:20px;margin-top:28px;border-top:1px solid var(--line)}
  .flow h2{font-size:clamp(20px,2vw,25px);margin-bottom:8px}
  .next{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:baseline;padding-block:clamp(28px,4vw,48px);border-top:1px solid var(--ink)}
  .next .mono{grid-column:1/5;color:var(--muted)}
  .next strong{grid-column:5/12;font:500 clamp(22px,2.6vw,36px)/1.3 var(--head);transition:color .15s}
  .arrow{grid-column:12;text-align:right;font-size:24px;transition:transform .18s,color .15s}
  .next:hover strong,.next:hover .arrow{color:var(--accent)}
  .next:hover .arrow{transform:translateX(4px)}
  @media(max-width:860px){
    .art-glyph{display:none}
    .next{display:block}
    .next strong{display:block;margin-top:6px}
    .arrow{display:none}
  }
</style>
