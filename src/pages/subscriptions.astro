---
import Layout from '../layouts/Layout.astro';
---
<Layout title="订阅工具">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">SUBSCRIPTION</span>
      <h1>订阅链接工具</h1>
      <p>粘贴服务商提供的订阅地址，复制链接或生成客户端导入入口。</p>
    </header>
    <section class="sec">
      <div class="sec-head">
        <p class="note">链接仅在当前页面处理，不上传、不保存。</p>
        <p class="hint">这里生成导入入口，不转换订阅格式；请确认服务商提供的格式与你的客户端兼容。导入需要设备已安装支持该协议的客户端。</p>
      </div>
      <div class="sec-body tool">
        <label for="url">第三方订阅链接</label>
        <input id="url" type="url" placeholder="https://example.com/subscribe?token=…" autocomplete="off"/>
        <label for="client">目标客户端</label>
        <select id="client"><option value="clash">Clash</option><option value="shadowrocket">Shadowrocket</option></select>
        <div class="actions">
          <button class="btn btn-line" id="copy" type="button">复制订阅地址</button>
          <button class="btn" id="generate" type="button">生成导入入口</button>
        </div>
        <p id="status" role="status" class="result"></p>
        <a id="import" class="btn btn-go" hidden>打开客户端 <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</Layout>
<script>
const input=document.querySelector<HTMLInputElement>('#url')!;const status=document.querySelector<HTMLElement>('#status')!;const link=document.querySelector<HTMLAnchorElement>('#import')!;
function value(){const raw=input.value.trim();try{const u=new URL(raw);if(!['https:','http:'].includes(u.protocol))throw Error();return raw}catch{status.textContent='请输入有效的 HTTP 或 HTTPS 订阅地址。';link.hidden=true;return null}}
document.querySelector('#copy')!.addEventListener('click',async()=>{const v=value();if(!v)return;try{await navigator.clipboard.writeText(v);status.textContent='订阅地址已复制。'}catch{status.textContent='复制失败，请手动选择输入框中的地址复制。'}});
document.querySelector('#generate')!.addEventListener('click',()=>{const v=value();if(!v)return;const client=(document.querySelector('#client') as HTMLSelectElement).value;link.href=client==='clash'?`clash://install-config?url=${encodeURIComponent(v)}&name=${encodeURIComponent('机场巡查订阅')}`:`shadowrocket://add/${v}`;link.hidden=false;status.textContent='导入入口已生成。请在客户端中确认订阅。'});input.addEventListener('input',()=>{link.hidden=true;status.textContent=''});document.querySelector('#client')!.addEventListener('change',()=>{link.hidden=true;status.textContent=''});
</script>
<style>
  [hidden]{display:none!important}
  .hint{margin-top:12px;font-size:14px;color:var(--muted);max-width:26em}
  .tool{max-width:720px}
  label{display:block;margin:24px 0 8px;font-weight:500;font-size:15px}
  label:first-child{margin-top:0}
  input,select{width:100%;min-height:50px;padding:0 14px;border:1px solid var(--ink);border-radius:0;background:#fff;color:var(--ink);font:500 15px var(--mono-f)}
  input::placeholder{color:var(--muted)}
  input:focus,select:focus{outline:2px solid var(--accent);outline-offset:1px}
  .actions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}
  .btn{display:flex;align-items:center;justify-content:center;gap:12px;min-height:50px;padding:0 14px;border:1px solid var(--ink);border-radius:0;background:var(--ink);color:var(--paper);font:500 15px var(--head);cursor:pointer;transition:background .15s,color .15s,border-color .15s}
  .btn:hover{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn-line{background:transparent;color:var(--ink)}
  .btn-go{background:var(--accent);border-color:var(--accent);color:#fff}
  .result{min-height:1.75em;margin-top:14px;font-size:14px;overflow-wrap:anywhere}
  @media(max-width:420px){.actions{grid-template-columns:1fr}}
</style>
