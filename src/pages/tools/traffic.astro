---
import Layout from '../../layouts/Layout.astro';
// 每小时用量（GB）。视频三档取 Netflix 帮助中心公布的上限（标清约 1、高清最多 3、超高清最多 7）；
// 其余是常见经验值，只用于粗估，页面上也这样说明。
const rows = [
  { id: 'web', label: '网页、社交、聊天', note: '图文为主', rate: 0.15, hours: 2 },
  { id: 'short', label: '短视频', note: '竖屏信息流', rate: 0.7, hours: 1 },
  { id: 'video', label: '长视频', note: '按清晰度', rate: 3, hours: 1, quality: true },
  { id: 'call', label: '视频通话、会议', note: '高清画面', rate: 1, hours: 0 },
  { id: 'music', label: '音乐、播客', note: '在线播放', rate: 0.1, hours: 0 },
  { id: 'ai', label: 'AI 对话', note: '以文字为主', rate: 0.03, hours: 0.5 },
];
---
<Layout title="每月流量估算｜按使用时长算出大约需要多少 GB" description="每月需要多少流量？输入每天看视频、刷网页、开会和下载的时长，按清晰度粗略估算每月GB用量，再对照机场套餐档位选择月流量，避免买多浪费或买少不够用。">
  <div class="wrap">
    <header class="page-head">
      <span class="mono">TRAFFIC ESTIMATE</span>
      <h1>每月要多少流量？</h1>
      <p>填每天大概用多久，算出一个月的粗略用量。结果只是估算，第一个月最好对照用户中心的实际消耗再调整。</p>
    </header>
    <section class="sec est">
      <div class="sec-head"><div class="sec-sticky">
        <div class="result" aria-live="polite">
          <span class="mono">估算结果</span>
          <p class="r-total"><b id="t-total">0</b> GB/月</p>
          <p class="r-tier" id="t-tier">填好左侧时长后显示建议档位。</p>
          <a class="link" href="/category/airports/#plans">对照各品牌套餐 <span aria-hidden="true">→</span></a>
        </div>
      </div></div>
      <form class="sec-body rows" id="est">
        {rows.map((r) => (
          <div class="row">
            <label for={r.id}><strong>{r.label}</strong><small>{r.note}</small></label>
            {r.quality && (
              <select id="video-q" aria-label="长视频清晰度">
                <option value="1">标清</option>
                <option value="3" selected>高清</option>
                <option value="7">4K 超高清</option>
              </select>
            )}
            <div class="num"><input id={r.id} type="number" inputmode="decimal" min="0" max="24" step="0.5" value={r.hours} data-rate={r.rate}/><span>小时/天</span></div>
          </div>
        ))}
        <div class="row">
          <label for="dl"><strong>下载与更新</strong><small>游戏、系统、网盘</small></label>
          <div class="num"><input id="dl" type="number" inputmode="decimal" min="0" step="1" value="5"/><span>GB/月</span></div>
        </div>
        <div class="row">
          <label for="days"><strong>每月使用天数</strong><small>不是每天都用就改小</small></label>
          <div class="num"><input id="days" type="number" inputmode="numeric" min="1" max="31" step="1" value="30"/><span>天</span></div>
        </div>
        <p class="fine">算法：各项小时数 × 每小时用量 × 天数，加上下载量，再加 10% 余量（协议开销、重连和偶尔的高峰）。长视频三档按 Netflix 公布的每小时上限（标清约 1 GB、高清最多 3 GB、4K 最多 7 GB）；其余为常见经验值，不同应用和画质差别很大。注意部分节点有倍率，2× 节点会按两倍扣除。</p>
      </form>
    </section>
  </div>
</Layout>

<script>
  const form = document.getElementById('est') as HTMLFormElement;
  const total = document.getElementById('t-total')!;
  const tier = document.getElementById('t-tier')!;
  const quality = document.getElementById('video-q') as HTMLSelectElement;
  const num = (id: string) => Math.max(0, parseFloat((document.getElementById(id) as HTMLInputElement).value) || 0);

  const calc = () => {
    const days = Math.min(31, Math.max(1, num('days')));
    let perDay = 0;
    form.querySelectorAll<HTMLInputElement>('input[data-rate]').forEach((el) => {
      const rate = el.id === 'video' ? parseFloat(quality.value) : parseFloat(el.dataset.rate!);
      perDay += Math.min(24, Math.max(0, parseFloat(el.value) || 0)) * rate;
    });
    const gb = Math.round((perDay * days + num('dl')) * 1.1);
    total.textContent = String(gb);
    tier.textContent =
      gb === 0 ? '填好左侧时长后显示建议档位。'
      : gb <= 60 ? '轻度使用：年付轻量方案或不限时包通常够用。'
      : gb <= 150 ? '日常使用：每月 100～150 GB 的入门周期套餐。'
      : gb <= 300 ? '视频较多：每月 200～300 GB 的套餐更稳妥。'
      : '重度使用：考虑每月 500 GB 以上的套餐，或把下载类用途改走直连。';
  };
  form.addEventListener('input', calc);
  form.addEventListener('submit', (e) => e.preventDefault());
  calc();
</script>

<style>
  .est{border-top:1px solid var(--ink)}
  .result{padding:24px;background:var(--ink);color:var(--paper);--accent:#3FBF8F}
  .result .mono{color:#A8ACAD}
  .r-total{margin-top:8px;font:500 18px var(--head)}
  .r-total b{font:500 clamp(48px,6vw,72px)/1 var(--head);color:var(--accent);margin-right:6px}
  .r-tier{margin:14px 0 18px;font-size:15px;color:#E4E5E1}
  .result .link{border-color:#5F6466}
  .rows{border-top:1px solid var(--ink)}
  .row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
  .row label strong{display:block;font:500 17px var(--head)}
  .row label small{display:block;font-size:13px;color:var(--muted)}
  .row select{grid-column:2;min-height:44px;padding:0 10px;border:1px solid var(--ink);border-radius:0;background:#fff;font:500 14px var(--head)}
  .num{grid-column:3;display:flex;align-items:center;gap:8px}
  .num input{width:88px;min-height:44px;padding:0 10px;border:1px solid var(--ink);border-radius:0;background:#fff;font:500 16px var(--mono-f);text-align:right}
  .num span{width:56px;font-size:13px;color:var(--muted)}
  .row input:focus,.row select:focus{outline:2px solid var(--accent);outline-offset:1px}
  .fine{margin-top:20px;font-size:13px;line-height:1.8;color:var(--muted);max-width:44em}
  @media(max-width:860px){.result{margin-bottom:8px}}
  @media(max-width:480px){
    .row{grid-template-columns:minmax(0,1fr) auto}
    .row select{grid-column:1/-1;grid-row:2;width:100%}
    .num{grid-column:2}
    .num input{width:72px}
  }
</style>
